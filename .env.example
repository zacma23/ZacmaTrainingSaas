# ============================================================================
# ZACMA TECHNOLOGY & TRAINING INSTITUTE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env (never commit real secrets to GitHub).
# ============================================================================

# --- Server-Side Gemini AI Assistant (Required for ZACMA AI ASSISTANT) ---
# Must remain strictly server-side; never prefix with VITE_ and never commit real keys to GitHub.
# Add this in Vercel -> Project Settings -> Environment Variables (Production, Preview, Development).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional: defaults to gemini-4-hydrogen with automatic fallback to gemini-flash-latest on 404.
GEMINI_MODEL="gemini-flash-latest"

# --- Application Runtime ---
APP_URL="http://localhost:3000"
PORT="3000"

# --- Cron Job Authentication (Vercel Cron -> /api/cron/reminders) ---
CRON_SECRET="CHANGE_ME_RANDOM_SECRET"

# --- Optional: Use Your Own Firebase Project on Vercel ---
# Leave blank to use the bundled firebase-applet-config.json (project gen-lang-client-0608981624).
# If you added your Vercel domain to YOUR OWN Firebase project, set these in Vercel & redeploy:
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID="(default)"

# --- External Supabase PostgreSQL Target (Project: mcxbwxfvalodqgbwyobo) ---
# Set these in Vercel Project Settings -> Environment Variables (never commit real secrets).
SUPABASE_URL="https://mcxbwxfvalodqgbwyobo.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_DB_HOST="db.mcxbwxfvalodqgbwyobo.supabase.co"
SUPABASE_DB_PORT="5432"
SUPABASE_DB_NAME="postgres"
SUPABASE_DB_USER="postgres"
DATABASE_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@db.mcxbwxfvalodqgbwyobo.supabase.co:5432/postgres"

# --- Optional External Notification Channel Adapters ---
# Leave blank if using In-App Notifications only. Channels will honestly report "Not Configured".
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ZACMA Finance <finance@zacma.edu.et>"

# --- SMS Gateway Providers (Ethiopian Mobile Support: +251 9x / +251 7x) ---
# Keep ALL SMS API credentials strictly in server environment variables (never prefix with VITE_).
# Option 1 (Recommended for Ethiopia): AfroMessage (https://afromessage.com)
AFROMESSAGE_API_KEY=""
AFROMESSAGE_IDENTIFIER_ID=""
AFROMESSAGE_SENDER_NAME="ZACMA"

# Option 2 (Ethiopia Local): GeezSMS (https://geezsms.com)
GEEZSMS_API_TOKEN=""
GEEZSMS_SHORTCODE_ID=""

# Option 3 (International + Ethiopia): Twilio SMS
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Option 4 (East Africa): Africa's Talking
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME=""
AFRICASTALKING_SENDER_ID=""

WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- Chapa Payment Gateway (Online Student Fee Payments — Official API v1) ---
# CRITICAL SECURITY: Keep all Chapa credentials strictly on the trusted backend (never prefix with VITE_).
# Set these in Vercel -> Project Settings -> Environment Variables (Production, Preview, Development).
# Use Chapa TEST keys (CHAPUBK_TEST-... / CHASECK_TEST-...) for staging and LIVE keys for production.
CHAPA_PUBLIC_KEY="your_regenerated_public_key"
CHAPA_SECRET_KEY="your_regenerated_secret_key"
CHAPA_ENCRYPTION_KEY="your_regenerated_encryption_key"
# Optional: Chapa Webhook Secret Hash configured in Chapa Dashboard -> Settings -> Webhooks.
# If omitted, the backend validates webhook HMAC-SHA256 signatures against CHAPA_ENCRYPTION_KEY.
CHAPA_WEBHOOK_SECRET=""


