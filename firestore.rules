        && isNonEmptyString(data.department, 80)
        && isNonEmptyString(data.jobPosition, 80)
        && data.portalRole in ['ADMIN', 'MANAGER', 'ACCOUNTANT', 'INSTRUCTOR', 'RECEPTIONIST', 'HR_OFFICER', 'GENERAL_STAFF']
        && isNonEmptyString(data.employmentStartDate, 20)
