        && data.keys().hasOnly(['tenantId', 'adminTimeoutMinutes', 'userTimeoutMinutes', 'warningBeforeSeconds', 'maxFailedLogins', 'lockoutMinutes', 'enforceAuditOnExports', 'updatedBy', 'updatedByName', 'updatedAt'])
