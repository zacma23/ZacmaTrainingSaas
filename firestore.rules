    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorId', 'actorName', 'actorRole', 'action', 'entityType', 'entityId', 'summary', 'createdAt'])
        && data.keys().hasOnly(['tenantId', 'actorId', 'actorName', 'actorRole', 'actorPlatformRole', 'action', 'entityType', 'entityId', 'summary', 'result', 'createdAt'])
