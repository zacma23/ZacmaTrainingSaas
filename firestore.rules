    function isValidIdNumberLock(data) {
      return data.keys().hasAll(['idNumberHash', 'documentType', 'subjectType', 'subjectId', 'subjectCode', 'subjectName', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['tenantId', 'idNumberHash', 'documentType', 'subjectType', 'subjectId', 'subjectCode', 'subjectName', 'createdBy', 'createdAt'])
        && isOptionalString(data, 'tenantId', 80)
        && isNonEmptyString(data.idNumberHash, 80)
        && data.documentType in ['NATIONAL_ID', 'ETHIOPIAN_FAYDA_ID', 'PASSPORT', 'DRIVING_LICENCE']
        && data.subjectType in ['STUDENT', 'STAFF']
        && isValidId(data.subjectId)
        && isNonEmptyString(data.subjectCode, 28)
        && isNonEmptyString(data.subjectName, 120)
