        && data.keys().hasOnly(['tenantId', 'ownerPhoneNumber', 'activeProvider', 'senderId', 'smsEnabled', 'portalNotificationsEnabled', 'internalMessagingEnabled', 'testMode', 'allowStudentToInstructor', 'allowStudentToAdmin', 'allowStudentToStudent', 'allowAttachments', 'updatedBy', 'updatedByName', 'updatedAt'])
