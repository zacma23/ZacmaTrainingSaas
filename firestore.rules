    function isValidIdentityDocument(data) {
      return data.keys().hasAll(['subjectType', 'subjectId', 'subjectCode', 'subjectName', 'documentType', 'idNumberMasked', 'idNumberHash', 'encryptionAlg', 'encryptionIv', 'encryptedPayload', 'hasFrontImage', 'hasBackImage', 'ocrConfidence', 'verificationStatus', 'uploadedBy', 'uploadedByName', 'isRedacted', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'subjectType', 'subjectId', 'subjectCode', 'subjectName', 'documentType', 'idNumberMasked', 'idNumberHash', 'documentExpiryDate', 'encryptionAlg', 'encryptionIv', 'encryptedPayload', 'fileMimeType', 'hasFrontImage', 'hasBackImage', 'ocrConfidence', 'ocrWarnings', 'verificationStatus', 'verificationNotes', 'uploadedBy', 'uploadedByName', 'verifiedBy', 'verifiedByName', 'verifiedAt', 'retentionDeleteAfter', 'isRedacted', 'createdAt', 'updatedAt'])
        && isOptionalString(data, 'tenantId', 80)
