    function isValidIdCounter(data) {
      return data.keys().hasAll(['prefix', 'currentValue', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'prefix', 'currentValue', 'updatedBy', 'updatedAt'])
        && isOptionalString(data, 'tenantId', 80)
        && isNonEmptyString(data.prefix, 20)
        && data.prefix.matches('^[A-Z0-9]{2,10}-(?:STU|STA)$')
        && data.currentValue is int && data.currentValue >= 1 && data.currentValue <= 9999999
        && isNonEmptyString(data.updatedBy, 128)
        && isNonEmptyString(data.updatedAt, 40);
