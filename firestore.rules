        && (!('gender' in data) || data.gender in ['Male', 'Female', 'Unspecified'])
        && data.idDocumentType in ['NATIONAL_ID', 'ETHIOPIAN_FAYDA_ID', 'PASSPORT', 'DRIVING_LICENCE']
        && isOptionalString(data, 'idNumberMasked', 40)
        && isOptionalString(data, 'idNumberHash', 80)
        && isOptionalString(data, 'idExpiryDate', 20)
        && isOptionalString(data, 'idVaultRefId', 128)
