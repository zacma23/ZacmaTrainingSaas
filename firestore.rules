        && data.keys().hasOnly(['tenantId', 'staffCode', 'fullName', 'address', 'phone', 'email', 'dateOfBirth', 'nationality', 'gender', 'idDocumentType', 'idNumberMasked', 'idNumberHash', 'idExpiryDate', 'idVaultRefId', 'idVerificationStatus', 'department', 'jobPosition', 'portalRole', 'employmentStartDate', 'employmentStartDateEthiopian', 'photoUrl', 'linkedProfileUid', 'registrationStatus', 'registeredBy', 'registeredByName', 'approvedBy', 'approvedByName', 'approvedAt', 'rejectionReason', 'ocrConfidenceSummary', 'createdAt', 'updatedAt'])
        && isOptionalString(data, 'tenantId', 80)
