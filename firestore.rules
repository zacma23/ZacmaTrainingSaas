    function isValidStaffCompensation(data) {
      return data.keys().hasAll(['staffId', 'staffCode', 'salaryEtb', 'payFrequency', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'staffId', 'staffCode', 'salaryEtb', 'payFrequency', 'notes', 'updatedBy', 'updatedByName', 'createdAt', 'updatedAt'])
