        && data.keys().hasOnly(['tenantId', 'adjustmentRef', 'enrollmentId', 'studentId', 'studentCode', 'studentName', 'courseId', 'courseName', 'paymentId', 'type', 'amountEtb', 'effectiveDate', 'reason', 'approvedBy', 'approvedByName', 'createdAt'])
