    // ---------------------------------------------------------
    // Validation Blueprints — ZACMA SaaS Platform Collections
    // ---------------------------------------------------------
    function isValidTenant(data) {
      return data.keys().hasAll(['tenantId', 'name', 'shortName', 'slug', 'businessType', 'email', 'phone', 'country', 'city', 'address', 'primaryColor', 'secondaryColor', 'studentIdPrefix', 'staffIdPrefix', 'receiptPrefix', 'currency', 'timezone', 'academicYear', 'paymentMethods', 'defaultLanguage', 'dateFormat', 'notificationEmailEnabled', 'notificationSmsEnabled', 'notificationWhatsappEnabled', 'emailGatewayStatus', 'smsGatewayStatus', 'whatsappGatewayStatus', 'status', 'planId', 'planCode', 'planName', 'billingCycle', 'monthlyPriceEtb', 'annualPriceEtb', 'studentLimit', 'staffLimit', 'storageLimitMb', 'storageUsedMb', 'aiMonthlyQuota', 'aiRequestsUsed', 'enabledModules', 'primaryAdminName', 'primaryAdminEmail', 'primaryAdminPhone', 'primaryAdminPosition', 'subscriptionStartDate', 'subscriptionExpiresAt', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'name', 'shortName', 'slug', 'businessType', 'email', 'phone', 'country', 'city', 'address', 'website', 'logoUrl', 'primaryColor', 'secondaryColor', 'studentIdPrefix', 'staffIdPrefix', 'receiptPrefix', 'currency', 'timezone', 'academicYear', 'paymentMethods', 'defaultLanguage', 'dateFormat', 'invoiceFooterNote', 'notificationEmailEnabled', 'notificationSmsEnabled', 'notificationWhatsappEnabled', 'emailGatewayStatus', 'smsGatewayStatus', 'whatsappGatewayStatus', 'smsSenderLabel', 'status', 'planId', 'planCode', 'planName', 'billingCycle', 'monthlyPriceEtb', 'annualPriceEtb', 'studentLimit', 'staffLimit', 'storageLimitMb', 'storageUsedMb', 'aiMonthlyQuota', 'aiRequestsUsed', 'aiMonthlyTokenLimit', 'aiDocScanLimit', 'enabledModules', 'primaryAdminUid', 'primaryAdminName', 'primaryAdminEmail', 'primaryAdminPhone', 'primaryAdminPosition', 'subscriptionStartDate', 'trialEndsAt', 'subscriptionExpiresAt', 'suspendedReason', 'suspendedAt', 'isDefaultPlatformTenant', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'])
        && isValidId(data.tenantId)
        && isNonEmptyString(data.name, 140)
        && isNonEmptyString(data.shortName, 40)
        && isNonEmptyString(data.slug, 80)
        && isNonEmptyString(data.businessType, 80)
        && isNonEmptyString(data.email, 160)
        && isNonEmptyString(data.phone, 30)
        && isNonEmptyString(data.country, 80)
        && isNonEmptyString(data.city, 80)
        && isNonEmptyString(data.address, 240)
        && isOptionalString(data, 'website', 200)
        && isOptionalString(data, 'logoUrl', 90000)
        && isNonEmptyString(data.primaryColor, 20)
        && isNonEmptyString(data.secondaryColor, 20)
        && isNonEmptyString(data.studentIdPrefix, 12)
        && data.studentIdPrefix.matches('^[A-Z0-9]{2,10}$')
        && isNonEmptyString(data.staffIdPrefix, 12)
        && data.staffIdPrefix.matches('^[A-Z0-9]{2,10}$')
        && isNonEmptyString(data.receiptPrefix, 16)
        && isValidCurrency(data.currency)
        && isNonEmptyString(data.timezone, 60)
        && isNonEmptyString(data.academicYear, 30)
        && isBoundedStringList(data.paymentMethods, 10)
        && isNonEmptyString(data.defaultLanguage, 40)
        && data.dateFormat in ['GREGORIAN_AND_ETHIOPIAN', 'GREGORIAN_ONLY', 'DD/MM/YYYY', 'YYYY-MM-DD']
        && isOptionalString(data, 'invoiceFooterNote', 300)
        && data.notificationEmailEnabled is bool
        && data.notificationSmsEnabled is bool
        && data.notificationWhatsappEnabled is bool
        && data.emailGatewayStatus in ['CONFIGURED', 'UNCONFIGURED']
        && data.smsGatewayStatus in ['CONFIGURED', 'UNCONFIGURED']
        && data.whatsappGatewayStatus in ['CONFIGURED', 'UNCONFIGURED']
        && isOptionalString(data, 'smsSenderLabel', 30)
        && data.status in ['ACTIVE', 'TRIAL', 'SUSPENDED', 'PENDING', 'EXPIRED']
        && isNonEmptyString(data.planId, 80)
        && isNonEmptyString(data.planCode, 40)
        && isNonEmptyString(data.planName, 80)
        && data.billingCycle in ['MONTHLY', 'ANNUAL', 'TRIAL', 'CUSTOM']
        && isNonNegativeNumber(data.monthlyPriceEtb)
        && isNonNegativeNumber(data.annualPriceEtb)
        && isPositiveNumber(data.studentLimit)
        && isPositiveNumber(data.staffLimit)
        && isPositiveNumber(data.storageLimitMb)
        && isNonNegativeNumber(data.storageUsedMb)
        && isNonNegativeNumber(data.aiMonthlyQuota)
        && isNonNegativeNumber(data.aiRequestsUsed)
        && (!('aiMonthlyTokenLimit' in data) || isNonNegativeNumber(data.aiMonthlyTokenLimit))
        && (!('aiDocScanLimit' in data) || isNonNegativeNumber(data.aiDocScanLimit))
        && isBoundedStringList(data.enabledModules, 20)
        && isOptionalString(data, 'primaryAdminUid', 128)
        && isNonEmptyString(data.primaryAdminName, 120)
        && isNonEmptyString(data.primaryAdminEmail, 160)
        && isNonEmptyString(data.primaryAdminPhone, 30)
        && isNonEmptyString(data.primaryAdminPosition, 80)
        && isNonEmptyString(data.subscriptionStartDate, 20)
        && isOptionalString(data, 'trialEndsAt', 20)
        && isNonEmptyString(data.subscriptionExpiresAt, 20)
        && isOptionalString(data, 'suspendedReason', 300)
        && isOptionalString(data, 'suspendedAt', 40)
        && (!('isDefaultPlatformTenant' in data) || data.isDefaultPlatformTenant is bool)
        && isNonEmptyString(data.createdBy, 128)
        && isNonEmptyString(data.createdByName, 120)
        && isNonEmptyString(data.createdAt, 40)
        && isNonEmptyString(data.updatedAt, 40);
    }

    function isValidSubscriptionPlan(data) {
      return data.keys().hasAll(['code', 'name', 'tagline', 'monthlyPriceEtb', 'annualPriceEtb', 'trialDays', 'studentLimit', 'staffLimit', 'storageLimitMb', 'aiMonthlyQuota', 'includedModules', 'isActive', 'updatedAt'])
        && data.keys().hasOnly(['code', 'name', 'tagline', 'monthlyPriceEtb', 'annualPriceEtb', 'trialDays', 'studentLimit', 'staffLimit', 'storageLimitMb', 'aiMonthlyQuota', 'includedModules', 'isActive', 'isFeatured', 'updatedAt'])
        && data.code in ['FREE_TRIAL', 'BASIC', 'PROFESSIONAL', 'ENTERPRISE', 'CUSTOM']
        && isNonEmptyString(data.name, 80)
        && isNonEmptyString(data.tagline, 160)
        && isNonNegativeNumber(data.monthlyPriceEtb)
        && isNonNegativeNumber(data.annualPriceEtb)
        && isNonNegativeNumber(data.trialDays)
        && isPositiveNumber(data.studentLimit)
        && isPositiveNumber(data.staffLimit)
        && isPositiveNumber(data.storageLimitMb)
        && isNonNegativeNumber(data.aiMonthlyQuota)
        && isBoundedStringList(data.includedModules, 20)
        && data.isActive is bool
        && (!('isFeatured' in data) || data.isFeatured is bool)
        && isNonEmptyString(data.updatedAt, 40);
    }

    function isValidPlatformSubscription(data) {
      return data.keys().hasAll(['tenantId', 'tenantName', 'planId', 'planCode', 'planName', 'billingCycle', 'priceEtb', 'currency', 'status', 'startDate', 'expiresAt', 'autoRenew', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'tenantName', 'planId', 'planCode', 'planName', 'billingCycle', 'priceEtb', 'currency', 'status', 'startDate', 'trialEndsAt', 'expiresAt', 'autoRenew', 'lastReminderSentAt', 'notes', 'updatedBy', 'createdAt', 'updatedAt'])
        && isValidId(data.tenantId)
        && isNonEmptyString(data.tenantName, 140)
        && isNonEmptyString(data.planId, 80)
        && isNonEmptyString(data.planCode, 40)
        && isNonEmptyString(data.planName, 80)
        && data.billingCycle in ['MONTHLY', 'ANNUAL', 'TRIAL', 'CUSTOM']
        && isNonNegativeNumber(data.priceEtb)
        && isValidCurrency(data.currency)
        && data.status in ['ACTIVE', 'TRIAL', 'OVERDUE', 'EXPIRED', 'CANCELLED', 'SUSPENDED']
        && isNonEmptyString(data.startDate, 20)
        && isOptionalString(data, 'trialEndsAt', 20)
        && isNonEmptyString(data.expiresAt, 20)
        && data.autoRenew is bool
        && isOptionalString(data, 'lastReminderSentAt', 40)
        && isOptionalString(data, 'notes', 400)
        && isNonEmptyString(data.updatedBy, 128)
        && isNonEmptyString(data.createdAt, 40)
        && isNonEmptyString(data.updatedAt, 40);
    }

    function isValidPlatformInvoice(data) {
      return data.keys().hasAll(['invoiceNumber', 'tenantId', 'tenantName', 'subscriptionId', 'planName', 'billingCycle', 'amountEtb', 'currency', 'dueDate', 'status', 'issuedBy', 'issuedByName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['invoiceNumber', 'tenantId', 'tenantName', 'subscriptionId', 'planName', 'billingCycle', 'amountEtb', 'currency', 'dueDate', 'status', 'paidAt', 'paymentRef', 'notes', 'issuedBy', 'issuedByName', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.invoiceNumber, 40)
        && isValidId(data.tenantId)
        && isNonEmptyString(data.tenantName, 140)
        && isNonEmptyString(data.subscriptionId, 128)
        && isNonEmptyString(data.planName, 80)
        && data.billingCycle in ['MONTHLY', 'ANNUAL', 'TRIAL', 'CUSTOM']
        && isNonNegativeNumber(data.amountEtb)
        && isValidCurrency(data.currency)
        && isNonEmptyString(data.dueDate, 20)
        && data.status in ['PENDING', 'PAID', 'OVERDUE', 'VOID']
        && isOptionalString(data, 'paidAt', 40)
        && isOptionalString(data, 'paymentRef', 80)
        && isOptionalString(data, 'notes', 400)
        && isNonEmptyString(data.issuedBy, 128)
        && isNonEmptyString(data.issuedByName, 120)
        && isNonEmptyString(data.createdAt, 40)
        && isNonEmptyString(data.updatedAt, 40);
    }

    function isValidPlatformPayment(data) {
      return data.keys().hasAll(['paymentRef', 'tenantId', 'tenantName', 'planName', 'amountEtb', 'currency', 'paymentDate', 'paymentMethod', 'status', 'recordedBy', 'recordedByName', 'createdAt'])
        && data.keys().hasOnly(['paymentRef', 'invoiceId', 'invoiceNumber', 'tenantId', 'tenantName', 'planName', 'amountEtb', 'currency', 'paymentDate', 'paymentMethod', 'status', 'recordedBy', 'recordedByName', 'notes', 'createdAt'])
        && isNonEmptyString(data.paymentRef, 80)
        && isOptionalString(data, 'invoiceId', 128)
        && isOptionalString(data, 'invoiceNumber', 40)
        && isValidId(data.tenantId)
        && isNonEmptyString(data.tenantName, 140)
        && isNonEmptyString(data.planName, 80)
        && isPositiveNumber(data.amountEtb)
        && isValidCurrency(data.currency)
        && isNonEmptyString(data.paymentDate, 20)
        && data.paymentMethod in ['Bank Transfer', 'Chapa', 'Telebirr', 'CBE Birr', 'Cash', 'Check']
        && data.status in ['COMPLETED', 'REFUNDED']
        && isNonEmptyString(data.recordedBy, 128)
        && isNonEmptyString(data.recordedByName, 120)
        && isOptionalString(data, 'notes', 400)
        && isNonEmptyString(data.createdAt, 40);
    }

    function isValidTenantInvitation(data) {
      return data.keys().hasAll(['token', 'tenantId', 'tenantName', 'email', 'emailLower', 'fullName', 'role', 'status', 'expiresAt', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['token', 'tenantId', 'tenantName', 'email', 'emailLower', 'fullName', 'phone', 'position', 'role', 'status', 'expiresAt', 'claimedByUid', 'claimedAt', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.token, 80)
        && isValidId(data.tenantId)
        && isNonEmptyString(data.tenantName, 140)
        && isNonEmptyString(data.email, 160)
        && isNonEmptyString(data.emailLower, 160)
        && isNonEmptyString(data.fullName, 120)
        && isOptionalString(data, 'phone', 30)
        && isOptionalString(data, 'position', 80)
        && isValidRoleCode(data.role)
        && data.status in ['PENDING', 'CLAIMED', 'REVOKED', 'EXPIRED']
        && isNonEmptyString(data.expiresAt, 40)
        && isOptionalString(data, 'claimedByUid', 128)
        && isOptionalString(data, 'claimedAt', 40)
        && isNonEmptyString(data.createdBy, 128)
        && isNonEmptyString(data.createdByName, 120)
        && isNonEmptyString(data.createdAt, 40)
        && isNonEmptyString(data.updatedAt, 40);
    }

    function isValidSupportAccessSession(data) {
      return data.keys().hasAll(['tenantId', 'tenantName', 'actorUid', 'actorName', 'actorPlatformRole', 'reason', 'status', 'startedAt', 'expiresAt'])
        && data.keys().hasOnly(['tenantId', 'tenantName', 'actorUid', 'actorName', 'actorPlatformRole', 'reason', 'status', 'startedAt', 'expiresAt', 'endedAt'])
        && isValidId(data.tenantId)
        && isNonEmptyString(data.tenantName, 140)
        && isNonEmptyString(data.actorUid, 128)
        && isNonEmptyString(data.actorName, 120)
        && isValidPlatformRole(data.actorPlatformRole)
        && isNonEmptyString(data.reason, 300)
        && data.status in ['ACTIVE', 'ENDED', 'EXPIRED']
        && isNonEmptyString(data.startedAt, 40)
        && isNonEmptyString(data.expiresAt, 40)
        && isOptionalString(data, 'endedAt', 40);
    }

    function isValidPlatformGlobalSettings(data) {
      return data.keys().hasAll(['platformName', 'supportEmail', 'supportPhone', 'defaultCurrency', 'defaultLanguage', 'defaultTrialDays', 'gracePeriodDays', 'autoSuspendExpiredDays', 'allowSelfSignupInstitutes', 'enforceSupportSessionReason', 'maxSupportSessionMinutes', 'updatedAt'])
        && data.keys().hasOnly(['platformName', 'supportEmail', 'supportPhone', 'defaultCurrency', 'defaultLanguage', 'defaultTrialDays', 'gracePeriodDays', 'autoSuspendExpiredDays', 'allowSelfSignupInstitutes', 'enforceSupportSessionReason', 'maxSupportSessionMinutes', 'defaultAiModel', 'aiMonthlyTokenLimit', 'aiDocScanLimit', 'updatedBy', 'updatedByName', 'updatedAt'])
        && isNonEmptyString(data.platformName, 120)
        && isNonEmptyString(data.supportEmail, 160)
        && isNonEmptyString(data.supportPhone, 30)
        && isValidCurrency(data.defaultCurrency)
        && isNonEmptyString(data.defaultLanguage, 40)
        && isNonNegativeNumber(data.defaultTrialDays) && data.defaultTrialDays <= 365
        && isNonNegativeNumber(data.gracePeriodDays) && data.gracePeriodDays <= 90
        && isNonNegativeNumber(data.autoSuspendExpiredDays) && data.autoSuspendExpiredDays <= 90
        && data.allowSelfSignupInstitutes is bool
        && data.enforceSupportSessionReason is bool
        && isPositiveNumber(data.maxSupportSessionMinutes) && data.maxSupportSessionMinutes <= 240
        && (!('defaultAiModel' in data) || data.defaultAiModel in ['gemini-4-hydrogen', 'gemini-3.1-flash-lite'])
        && (!('aiMonthlyTokenLimit' in data) || isNonNegativeNumber(data.aiMonthlyTokenLimit))
        && (!('aiDocScanLimit' in data) || isNonNegativeNumber(data.aiDocScanLimit))
        && isOptionalString(data, 'updatedBy', 128)
        && isOptionalString(data, 'updatedByName', 120)
        && isNonEmptyString(data.updatedAt, 40);
    }

    function isValidAiConversation(data) {
      return data.keys().hasAll(['tenantId', 'ownerUid', 'ownerName', 'roleScope', 'moduleScope', 'title', 'messagesJson', 'messageCount', 'lastMessagePreview', 'modelId', 'totalTokens', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'ownerUid', 'ownerName', 'roleScope', 'moduleScope', 'title', 'messagesJson', 'messageCount', 'lastMessagePreview', 'modelId', 'totalTokens', 'createdAt', 'updatedAt'])
        && isValidId(data.tenantId)
        && isNonEmptyString(data.ownerUid, 128)
        && isNonEmptyString(data.ownerName, 120)
        && data.roleScope in ['SUPER_ADMIN', 'ADMIN', 'MANAGER', 'ACCOUNTANT', 'INSTRUCTOR', 'RECEPTIONIST', 'HR_OFFICER', 'GENERAL_STAFF', 'STUDENT']
        && isNonEmptyString(data.moduleScope, 60)
        && isNonEmptyString(data.title, 140)
        && data.messagesJson is string && data.messagesJson.size() >= 2 && data.messagesJson.size() <= 90000
        && data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 200
        && data.lastMessagePreview is string && data.lastMessagePreview.size() <= 200
        && data.modelId in ['gemini-4-hydrogen', 'gemini-3.1-flash-lite']
        && isNonNegativeNumber(data.totalTokens)
        && isNonEmptyString(data.createdAt, 40)
        && isNonEmptyString(data.updatedAt, 40);
    }

    function isValidAiUsageLog(data) {
      return data.keys().hasAll(['tenantId', 'userId', 'userName', 'roleScope', 'moduleScope', 'featureType', 'modelId', 'promptTokens', 'outputTokens', 'totalTokens', 'estimatedCostUsd', 'status', 'createdAt'])
        && data.keys().hasOnly(['tenantId', 'userId', 'userName', 'roleScope', 'moduleScope', 'featureType', 'modelId', 'promptTokens', 'outputTokens', 'totalTokens', 'estimatedCostUsd', 'status', 'createdAt'])
        && isValidId(data.tenantId)
        && isNonEmptyString(data.userId, 128)
        && isNonEmptyString(data.userName, 120)
        && isNonEmptyString(data.roleScope, 40)
        && isNonEmptyString(data.moduleScope, 60)
        && data.featureType in ['CHAT', 'DOCUMENT_OCR', 'REPORT_GEN', 'DRAFT_GEN', 'SECURITY_AUDIT']
        && isNonEmptyString(data.modelId, 60)
        && isNonNegativeNumber(data.promptTokens)
        && isNonNegativeNumber(data.outputTokens)
        && isNonNegativeNumber(data.totalTokens)
        && isNonNegativeNumber(data.estimatedCostUsd)
        && data.status in ['SUCCESS', 'DENIED', 'ERROR']
        && isNonEmptyString(data.createdAt, 40);
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll(['tenantId', 'tenantName', 'subject', 'category', 'priority', 'status', 'description', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'tenantName', 'subject', 'category', 'priority', 'status', 'description', 'createdBy', 'createdByName', 'assignedToName', 'resolutionNotes', 'createdAt', 'updatedAt'])
        && isValidId(data.tenantId)
        && isNonEmptyString(data.tenantName, 140)
        && isNonEmptyString(data.subject, 160)
        && data.category in ['BILLING', 'TECHNICAL', 'ONBOARDING', 'SECURITY', 'MODULE_UPGRADE']
        && data.priority in ['LOW', 'MEDIUM', 'HIGH', 'URGENT']
        && data.status in ['OPEN', 'IN_PROGRESS', 'RESOLVED', 'CLOSED']
        && isNonEmptyString(data.description, 1200)
        && isNonEmptyString(data.createdBy, 128)
        && isNonEmptyString(data.createdByName, 120)
        && isOptionalString(data, 'assignedToName', 120)
        && isOptionalString(data, 'resolutionNotes', 800)
        && isNonEmptyString(data.createdAt, 40)
        && isNonEmptyString(data.updatedAt, 40);
    }

    function isConversationMember(convData) {
      return isSameTenant(convData) && (
        request.auth.uid in convData.participantIds
        || (convData.type == 'BROADCAST' && (
          convData.broadcastAudience == 'ALL_USERS'
          || (convData.broadcastAudience == 'ALL_STUDENTS' && isStudent())
          || (convData.broadcastAudience == 'ALL_INSTRUCTORS' && isInstructor())
          || (convData.broadcastAudience == 'ALL_ACCOUNTANTS' && isAccountant())
          || (convData.broadcastAudience == 'ALL_STAFF' && isStaff())
        ))
      );
    }

    function hasMatchingPendingInvitation(data) {
      return ('inviteId' in data)
        && isValidId(data.inviteId)
        && exists(/databases/$(database)/documents/tenant_invitations/$(data.inviteId))
        && get(/databases/$(database)/documents/tenant_invitations/$(data.inviteId)).data.status == 'PENDING'
        && request.auth.token.email != null
        && get(/databases/$(database)/documents/tenant_invitations/$(data.inviteId)).data.emailLower == request.auth.token.email.lower()
        && ('tenantId' in data)
        && data.tenantId == get(/databases/$(database)/documents/tenant_invitations/$(data.inviteId)).data.tenantId
        && data.role == get(/databases/$(database)/documents/tenant_invitations/$(data.inviteId)).data.role
        && !('platformRole' in data);
    }

    // ---------------------------------------------------------
    // Connection test document
    // ---------------------------------------------------------
    match /test/connection {
      allow get: if isSignedIn();
    }

    // ---------------------------------------------------------
    // 1. Roles
    // ---------------------------------------------------------
    match /roles/{roleId} {
      allow get: if isSignedIn() && isValidId(roleId) && (isStaff() || isStudent());
      allow list: if isSignedIn() && (isStaff() || isStudent());
      allow create, update: if isSignedIn() && isValidId(roleId) && isValidRole(incoming()) && (isPlatformAdmin() || isAdmin());
      allow delete: if isSignedIn() && isValidId(roleId) && isPlatformAdmin();
    }

    // ---------------------------------------------------------
    // 2. Profiles (Strict Tenant & Platform Role Isolation)
    // ---------------------------------------------------------
    match /profiles/{profileId} {
      allow get: if isSignedIn() && isValidId(profileId) && (
        profileId == request.auth.uid || isPlatformStaff() || (isAdmin() && isSameTenant(existing()))
      );
      allow list: if isSignedIn() && (
        isPlatformStaff() || (isAdmin() && isSameTenant(existing()))
      );
      allow create: if isSignedIn() && isValidId(profileId) && isValidProfile(incoming()) && (
        isPlatformAdmin() ||
        (isAdmin() && !('platformRole' in incoming()) && isSameTenant(incoming()) && isTenantWritable(userTenantId())) ||
        (profileId == request.auth.uid
          && incoming().uid == request.auth.uid
          && incoming().email == request.auth.token.email
          && !('linkedStudentId' in incoming())
          && !('allowedModules' in incoming())
          && !('canExportReports' in incoming())
          && incoming().isActive == true
          && (
            (isBootstrapAdmin() && incoming().role == 'ADMIN' && (!('platformRole' in incoming()) || incoming().platformRole == 'SUPER_ADMIN'))
            || hasMatchingPendingInvitation(incoming())
            || (!('platformRole' in incoming()) && incoming().role in ['INSTRUCTOR', 'STUDENT'] && docTenantId(incoming()) == 'zacma_default')
          ))
      );
      allow update: if isSignedIn() && isValidId(profileId) && isValidProfile(incoming()) && (
        isPlatformSuperAdmin() ||
        (isPlatformAdmin() && (!('platformRole' in incoming()) || incoming().platformRole != 'SUPER_ADMIN') && (!('platformRole' in existing()) || existing().platformRole != 'SUPER_ADMIN')) ||
        (isAdmin()
          && isSameTenant(existing())
          && docTenantId(incoming()) == docTenantId(existing())
          && !('platformRole' in incoming())
          && !('platformRole' in existing())
          && isTenantWritable(userTenantId())) ||
        (profileId == request.auth.uid
          && incoming().uid == existing().uid
          && incoming().role == existing().role
          && docTenantId(incoming()) == docTenantId(existing())
          && (!('platformRole' in incoming()) ? !('platformRole' in existing()) : (('platformRole' in existing()) && incoming().platformRole == existing().platformRole))
          && incoming().isActive == existing().isActive
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone', 'lastLoginAt', 'updatedAt'])) ||
        (profileId == request.auth.uid
          && isBootstrapAdmin()
          && incoming().uid == existing().uid
          && incoming().role == 'ADMIN'
          && incoming().platformRole == 'SUPER_ADMIN'
          && docTenantId(incoming()) == 'zacma_default')
      );
      allow delete: if isSignedIn() && isValidId(profileId) && profileId != request.auth.uid && (
        isPlatformSuperAdmin() ||
        (isAdmin() && isSameTenant(existing()) && !('platformRole' in existing()))
      );
    }

    // ---------------------------------------------------------
    // 3. Courses (Tenant-isolated; Admin manages; Staff & Student read)
    // ---------------------------------------------------------
    match /courses/{courseId} {
      allow get: if isSignedIn() && isValidId(courseId) && (isStaff() || isStudent()) && isSameTenant(existing());
      allow list: if isSignedIn() && (isStaff() || isStudent()) && isSameTenant(existing());
      allow create: if isSignedIn() && isValidId(courseId) && isValidCourse(incoming()) && (isPlatformAdmin() || (isAdmin() && isSameTenant(incoming()) && isTenantWritable(userTenantId())));
      allow update: if isSignedIn() && isValidId(courseId) && isValidCourse(incoming()) && incoming().createdAt == existing().createdAt && docTenantId(incoming()) == docTenantId(existing()) && (isPlatformAdmin() || (isAdmin() && isSameTenant(existing()) && isTenantWritable(userTenantId())));
      allow delete: if isSignedIn() && isValidId(courseId) && (isPlatformAdmin() || (isAdmin() && isSameTenant(existing()) && isTenantWritable(userTenantId())));
    }

    // ---------------------------------------------------------
    // 4. Payment Plans (Tenant-isolated; Finance reads; Admin manages)
    // ---------------------------------------------------------
    match /payment_plans/{planId} {
      allow get: if isSignedIn() && isValidId(planId) && isFinanceStaff() && isSameTenant(existing());
      allow list: if isSignedIn() && isFinanceStaff() && isSameTenant(existing());
      allow create: if isSignedIn() && isValidId(planId) && isValidPaymentPlan(incoming()) && (isPlatformAdmin() || (isAdmin() && isSameTenant(incoming()) && isTenantWritable(userTenantId())));
      allow update: if isSignedIn() && isValidId(planId) && isValidPaymentPlan(incoming()) && docTenantId(incoming()) == docTenantId(existing()) && (isPlatformAdmin() || (isAdmin() && isSameTenant(existing()) && isTenantWritable(userTenantId())));
      allow delete: if isSignedIn() && isValidId(planId) && (isPlatformAdmin() || (isAdmin() && isSameTenant(existing()) && isTenantWritable(userTenantId())));
    }

    // ---------------------------------------------------------
    // 5. Students (Strict Tenant Isolation + Suspended Write Lock)
    // ---------------------------------------------------------
    match /students/{studentId} {
      allow get: if isSignedIn() && isValidId(studentId) && isSameTenant(existing()) && (isStaff() || isOwnStudentRecord(studentId));
      allow list: if isSignedIn() && isStaff() && isSameTenant(existing());
      allow create: if isSignedIn() && isValidId(studentId) && isValidStudent(incoming()) && isSameTenant(incoming()) && isTenantWritable(docTenantId(incoming())) && (
        isPlatformAdmin() ||
        isAdmin() ||
        ((isAccountant() || isManager() || isReceptionist())
          && incoming().registrationStatus == 'PENDING'
          && incoming().registeredBy == request.auth.uid
          && (!('idVerificationStatus' in incoming()) || incoming().idVerificationStatus in ['UNVERIFIED', 'PENDING_REVIEW']))
      );
      allow update: if isSignedIn() && isValidId(studentId) && isValidStudent(incoming()) && incoming().createdAt == existing().createdAt && incoming().studentCode == existing().studentCode && docTenantId(incoming()) == docTenantId(existing()) && isSameTenant(existing()) && isTenantWritable(docTenantId(existing())) && (
        isPlatformAdmin() ||
        isAdmin() ||
        ((isAccountant() || isManager() || isReceptionist()) && existing().registrationStatus == 'PENDING' && incoming().registrationStatus == 'PENDING' && incoming().registeredBy == existing().registeredBy && incoming().courseFeeEtb == existing().courseFeeEtb && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone', 'altPhone', 'email', 'dateOfBirth', 'nationality', 'address', 'photoUrl', 'updatedAt']))
      );
      allow delete: if isSignedIn() && isValidId(studentId) && isSameTenant(existing()) && (isPlatformAdmin() || (isAdmin() && isTenantWritable(docTenantId(existing()))));
    }

    // ---------------------------------------------------------
    // 6. Enrollments (Strict Tenant Isolation + Student Own Read)
    // ---------------------------------------------------------
    match /enrollments/{enrollmentId} {
      allow get: if isSignedIn() && isValidId(enrollmentId) && isSameTenant(existing()) && (isStaff() || isOwnStudentRecord(existing().studentId));
      allow list: if isSignedIn() && isSameTenant(existing()) && (isStaff() || isOwnStudentRecord(existing().studentId));
      allow create: if isSignedIn() && isValidId(enrollmentId) && isValidEnrollment(incoming()) && isSameTenant(incoming()) && isTenantWritable(docTenantId(incoming())) && (
        isPlatformAdmin() ||
        isAdmin() ||
        ((isAccountant() || isManager() || isReceptionist()) && incoming().status == 'PENDING' && incoming().approvedPaidEtb == 0 && incoming().registeredBy == request.auth.uid)
      );
      allow update: if isSignedIn() && isValidId(enrollmentId) && isValidEnrollment(incoming()) && incoming().createdAt == existing().createdAt && docTenantId(incoming()) == docTenantId(existing()) && isSameTenant(existing()) && isTenantWritable(docTenantId(existing())) && (isPlatformAdmin() || isAdmin());
      allow delete: if isSignedIn() && isValidId(enrollmentId) && isSameTenant(existing()) && (isPlatformAdmin() || (isAdmin() && isTenantWritable(docTenantId(existing()))));
    }

    // ---------------------------------------------------------
    // 7. Payment Installments (Strict Tenant & Finance Isolation)
    // ---------------------------------------------------------
    match /payment_installments/{installmentId} {
      allow get: if isSignedIn() && isValidId(installmentId) && isSameTenant(existing()) && (isFinanceStaff() || isOwnStudentRecord(existing().studentId));
      allow list: if isSignedIn() && isSameTenant(existing()) && (isFinanceStaff() || isOwnStudentRecord(existing().studentId));
      allow create: if isSignedIn() && isValidId(installmentId) && isValidInstallment(incoming()) && isSameTenant(incoming()) && isTenantWritable(docTenantId(incoming())) && (
        isPlatformAdmin() ||
        isAdmin() ||
        ((isAccountant() || isManager()) && incoming().amountPaidEtb == 0 && incoming().status == 'UNPAID')
      );
      allow update: if isSignedIn() && isValidId(installmentId) && isValidInstallment(incoming()) && incoming().createdAt == existing().createdAt && docTenantId(incoming()) == docTenantId(existing()) && isSameTenant(existing()) && isTenantWritable(docTenantId(existing())) && (
        isPlatformAdmin() ||
        isAdmin() ||
        ((isAccountant() || isManager()) && incoming().amountDueEtb == existing().amountDueEtb && incoming().amountPaidEtb == existing().amountPaidEtb && incoming().status == 'OVERDUE' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
      );
      allow delete: if isSignedIn() && isValidId(installmentId) && isSameTenant(existing()) && (isPlatformAdmin() || (isAdmin() && isTenantWritable(docTenantId(existing()))));
    }

    // ---------------------------------------------------------
    // 8. Payments (Student Tuition Payments — Maker-Checker & Tenant Isolated)
    // ---------------------------------------------------------
    match /payments/{paymentId} {
      allow get: if isSignedIn() && isValidId(paymentId) && isSameTenant(existing()) && (isFinanceStaff() || isOwnStudentRecord(existing().studentId));
      allow list: if isSignedIn() && isSameTenant(existing()) && (isFinanceStaff() || isOwnStudentRecord(existing().studentId));
      allow create: if isSignedIn() && isValidId(paymentId) && isValidPayment(incoming()) && isSameTenant(incoming()) && isTenantWritable(docTenantId(incoming())) && (
        isPlatformAdmin() ||
        isAdmin() ||
        ((isAccountant() || isManager()) && incoming().status == 'PENDING' && incoming().recordedBy == request.auth.uid)
      );
      allow update: if isSignedIn() && isValidId(paymentId) && isValidPayment(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().transactionRef == existing().transactionRef
        && incoming().recordedBy == existing().recordedBy
        && incoming().amountEtb == existing().amountEtb
        && docTenantId(incoming()) == docTenantId(existing())
        && isSameTenant(existing())
        && isTenantWritable(docTenantId(existing()))
        && (isPlatformAdmin() || isAdmin())
        && existing().status == 'PENDING'
        && incoming().status in ['APPROVED', 'REJECTED']
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedByName', 'approvalDate', 'rejectionReason', 'receiptId', 'receiptNumber', 'updatedAt']);
      allow delete: if false;
    }

    // ---------------------------------------------------------
    // 9. Payment Reference Uniqueness Lock
    // ---------------------------------------------------------
    match /payment_refs/{refId} {
      allow get: if isSignedIn() && isValidId(refId) && isFinanceStaff();
      allow list: if false;
      allow create: if isSignedIn() && isValidId(refId) && isValidPaymentRef(incoming()) && isSameTenant(incoming()) && isTenantWritable(docTenantId(incoming())) && (
        isPlatformAdmin() ||
        isAdmin() ||
        ((isAccountant() || isManager()) && incoming().recordedBy == request.auth.uid)
      );
      allow update, delete: if false;
    }

    // ---------------------------------------------------------
    // 10. Receipts (Official immutable student tuition receipts)
    // ---------------------------------------------------------
    match /receipts/{receiptId} {
      allow get: if isSignedIn() && isValidId(receiptId) && isSameTenant(existing()) && (isFinanceStaff() || isOwnStudentRecord(existing().studentId));
      allow list: if isSignedIn() && isSameTenant(existing()) && (isFinanceStaff() || isOwnStudentRecord(existing().studentId));
      allow create: if isSignedIn() && isValidId(receiptId) && isValidReceipt(incoming()) && isSameTenant(incoming()) && isTenantWritable(docTenantId(incoming())) && (isPlatformAdmin() || isAdmin());
      allow update, delete: if false;
    }

    // ---------------------------------------------------------
    // 11. Expense Categories
    // ---------------------------------------------------------
    match /expense_categories/{categoryId} {
      allow get: if isSignedIn() && isValidId(categoryId) && isFinanceStaff() && isSameTenant(existing());
      allow list: if isSignedIn() && isFinanceStaff() && isSameTenant(existing());
      allow create: if isSignedIn() && isValidId(categoryId) && isValidExpenseCategory(incoming()) && (isPlatformAdmin() || (isAdmin() && isSameTenant(incoming()) && isTenantWritable(userTenantId())));
      allow update: if isSignedIn() && isValidId(categoryId) && isValidExpenseCategory(incoming()) && docTenantId(incoming()) == docTenantId(existing()) && (isPlatformAdmin() || (isAdmin() && isSameTenant(existing()) && isTenantWritable(userTenantId())));
      allow delete: if isSignedIn() && isValidId(categoryId) && (isPlatformAdmin() || (isAdmin() && isSameTenant(existing()) && isTenantWritable(userTenantId())));
    }

    // ---------------------------------------------------------
    // 12. Expenses
    // ---------------------------------------------------------
    match /expenses/{expenseId} {
      allow get: if isSignedIn() && isValidId(expenseId) && isFinanceStaff() && isSameTenant(existing());
      allow list: if isSignedIn() && isFinanceStaff() && isSameTenant(existing());
      allow create: if isSignedIn() && isValidId(expenseId) && isValidExpense(incoming()) && isSameTenant(incoming()) && isTenantWritable(docTenantId(incoming())) && (isPlatformAdmin() || isAdmin());
      allow update: if isSignedIn() && isValidId(expenseId) && isValidExpense(incoming()) && incoming().createdAt == existing().createdAt && docTenantId(incoming()) == docTenantId(existing()) && isSameTenant(existing()) && isTenantWritable(docTenantId(existing())) && (isPlatformAdmin() || isAdmin());
      allow delete: if isSignedIn() && isValidId(expenseId) && isSameTenant(existing()) && (isPlatformAdmin() || (isAdmin() && isTenantWritable(docTenantId(existing()))));
    }

    // ---------------------------------------------------------
    // 13. Attendance
    // ---------------------------------------------------------
    match /attendance/{attendanceId} {
      allow get: if isSignedIn() && isValidId(attendanceId) && isSameTenant(existing()) && (isStaff() || isOwnStudentRecord(existing().studentId));
      allow list: if isSignedIn() && isSameTenant(existing()) && (isStaff() || isOwnStudentRecord(existing().studentId));
      allow create: if isSignedIn() && isValidId(attendanceId) && isValidAttendance(incoming()) && isSameTenant(incoming()) && isTenantWritable(docTenantId(incoming())) && (
        isPlatformAdmin() ||
        isAdmin() ||
        (isInstructor() && incoming().recordedBy == request.auth.uid)
      );
      allow update: if isSignedIn() && isValidId(attendanceId) && isValidAttendance(incoming()) && incoming().createdAt == existing().createdAt && docTenantId(incoming()) == docTenantId(existing()) && isSameTenant(existing()) && isTenantWritable(docTenantId(existing())) && (
        isPlatformAdmin() ||
        isAdmin() ||
        (isInstructor() && incoming().recordedBy == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'remarks', 'recordedBy', 'recordedByName', 'updatedAt']))
      );
      allow delete: if isSignedIn() && isValidId(attendanceId) && isSameTenant(existing()) && (isPlatformAdmin() || (isAdmin() && isTenantWritable(docTenantId(existing()))));
    }

    // ---------------------------------------------------------
    // 14. Notifications (Tenant-scoped)
    // ---------------------------------------------------------
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && isSameTenant(existing()) && (
        isStaff() ||
        (isStudent() && (
          (('studentId' in existing()) && isOwnStudentRecord(existing().studentId)) ||
          (('recipientUid' in existing()) && existing().recipientUid == request.auth.uid) ||
          existing().targetRole == 'ALL'
        ))
      );
      allow list: if isSignedIn() && isSameTenant(existing()) && (
        isStaff() ||
        (isStudent() && (
          (('studentId' in existing()) && isOwnStudentRecord(existing().studentId)) ||
          (('recipientUid' in existing()) && existing().recipientUid == request.auth.uid) ||
          existing().targetRole == 'ALL'
        ))
      );
      allow create: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming()) && (
        isPlatformStaff() ||
        (isStaff() && isSameTenant(incoming())) ||
        (isStudent() && isSameTenant(incoming()) && incoming().type == 'NEW_INTERNAL_MESSAGE' && ('recipientUid' in incoming())) ||
        (isStudent() && isSameTenant(incoming()) && incoming().type == 'CHAPA_PAYMENT_VERIFIED' && ('studentId' in incoming()) && isOwnStudentRecord(incoming().studentId) && incoming().targetRole in ['ADMIN', 'STUDENT'])
      );
      allow update: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming()) && docTenantId(incoming()) == docTenantId(existing()) && isSameTenant(existing()) && (
        isPlatformAdmin() ||
        isAdmin() ||
        ((isStaff() || (isStudent() && (
          (('studentId' in existing()) && isOwnStudentRecord(existing().studentId)) ||
          (('recipientUid' in existing()) && existing().recipientUid == request.auth.uid) ||
          existing().targetRole == 'ALL'
        ))) && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']))
      );
      allow delete: if isSignedIn() && isValidId(notificationId) && isSameTenant(existing()) && (isPlatformAdmin() || isAdmin());
    }

    // ---------------------------------------------------------
    // 15. Notification Preferences (Self or Admin)
    // ---------------------------------------------------------
    match /notification_preferences/{prefId} {
      allow get: if isSignedIn() && isValidId(prefId) && (prefId == request.auth.uid || isPlatformAdmin() || isAdmin());
      allow list: if isSignedIn() && (isPlatformAdmin() || isAdmin());
      allow create, update: if isSignedIn() && isValidId(prefId) && isValidNotificationPreference(incoming()) && (
        isPlatformAdmin() ||
        isAdmin() ||
        (prefId == request.auth.uid && incoming().userId == request.auth.uid)
      );
      allow delete: if isSignedIn() && isValidId(prefId) && (isPlatformAdmin() || isAdmin());
    }

    // ---------------------------------------------------------
    // 16. Schema Migrations (Append-only Admin ledger)
    // ---------------------------------------------------------
    match /schema_migrations/{migId} {
      allow get: if isSignedIn() && isValidId(migId) && (isPlatformStaff() || isAdmin());
      allow list: if isSignedIn() && (isPlatformStaff() || isAdmin());
      allow create: if isSignedIn() && isValidId(migId) && isValidSchemaMigration(incoming()) && (isPlatformAdmin() || isAdmin());
      allow update, delete: if false;
    }

    // ---------------------------------------------------------
    // 17. Audit Logs (Strictly append-only immutable trail; Platform reads all, Institute Admin reads own tenant)
    // ---------------------------------------------------------
    match /audit_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && (isPlatformStaff() || (isAdmin() && isSameTenant(existing())));
      allow list: if isSignedIn() && (isPlatformStaff() || (isAdmin() && isSameTenant(existing())));
      allow create: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming()) && (isStaff() || isStudent()) && incoming().actorId == request.auth.uid && (isPlatformStaff() || isSameTenant(incoming()));
      allow update, delete: if false;
    }

    // ---------------------------------------------------------
    // 18. SMS Configuration
    // ---------------------------------------------------------
    match /sms_config/{configId} {
      allow get: if isSignedIn() && isValidId(configId) && isFinanceStaff() && isSameTenant(existing());
      allow list: if isSignedIn() && isFinanceStaff() && isSameTenant(existing());
      allow create, update: if isSignedIn() && isValidId(configId) && isValidSmsConfig(incoming()) && (isPlatformAdmin() || (isAdmin() && isSameTenant(incoming())));
      allow delete: if isSignedIn() && isValidId(configId) && (isPlatformAdmin() || (isAdmin() && isSameTenant(existing())));
    }

    // ---------------------------------------------------------
    // 19. Communication Policy
    // ---------------------------------------------------------
    match /communication_policy/{policyId} {
      allow get: if isSignedIn() && isValidId(policyId) && (isStaff() || isStudent());
      allow list: if isSignedIn() && (isPlatformAdmin() || isAdmin());
      allow create, update: if isSignedIn() && isValidId(policyId) && isValidCommunicationPolicy(incoming()) && (isPlatformAdmin() || isAdmin());
      allow delete: if isSignedIn() && isValidId(policyId) && (isPlatformAdmin() || isAdmin());
    }

    // ---------------------------------------------------------
    // 20. SMS Message Templates
    // ---------------------------------------------------------
    match /sms_templates/{templateId} {
      allow get: if isSignedIn() && isValidId(templateId) && isFinanceStaff() && isSameTenant(existing());
      allow list: if isSignedIn() && isFinanceStaff() && isSameTenant(existing());
      allow create, update: if isSignedIn() && isValidId(templateId) && isValidSmsTemplate(incoming()) && (isPlatformAdmin() || (isAdmin() && isSameTenant(incoming())));
      allow delete: if isSignedIn() && isValidId(templateId) && (isPlatformAdmin() || (isAdmin() && isSameTenant(existing())));
    }

    // ---------------------------------------------------------
    // 21. SMS Delivery Logs
    // ---------------------------------------------------------
    match /sms_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && isFinanceStaff() && isSameTenant(existing());
      allow list: if isSignedIn() && isFinanceStaff() && isSameTenant(existing());
      allow create: if isSignedIn() && isValidId(logId) && isValidSmsLog(incoming()) && isFinanceStaff() && isSameTenant(incoming()) && incoming().sentBy == request.auth.uid;
      allow update: if isSignedIn() && isValidId(logId) && isValidSmsLog(incoming()) && incoming().createdAt == existing().createdAt && docTenantId(incoming()) == docTenantId(existing()) && (isPlatformAdmin() || (isAdmin() && isSameTenant(existing())));
      allow delete: if false;
    }

    // ---------------------------------------------------------
    // 22. Unified Notification Channel Rules Matrix
    // ---------------------------------------------------------
    match /notification_channel_rules/{ruleId} {
      allow get: if isSignedIn() && isValidId(ruleId) && isStaff() && isSameTenant(existing());
      allow list: if isSignedIn() && isStaff() && isSameTenant(existing());
      allow create, update: if isSignedIn() && isValidId(ruleId) && isValidNotificationChannelRule(incoming()) && (isPlatformAdmin() || (isAdmin() && isSameTenant(incoming())));
      allow delete: if isSignedIn() && isValidId(ruleId) && (isPlatformAdmin() || (isAdmin() && isSameTenant(existing())));
    }

    // ---------------------------------------------------------
    // 23. Directory Users (Tenant-scoped PII-free messaging directory)
    // ---------------------------------------------------------
    match /directory_users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isStaff() || isStudent()) && isSameTenant(existing());
      allow list: if isSignedIn() && isSameTenant(existing()) && (isPlatformAdmin() || isAdmin() || ((isStaff() || isStudent()) && existing().isActive == true));
      allow create, update: if isSignedIn() && isValidId(userId) && isValidDirectoryUser(incoming()) && (
        isPlatformAdmin() ||
        (isAdmin() && isSameTenant(incoming())) ||
        (userId == request.auth.uid
          && incoming().uid == request.auth.uid
          && profileExists()
          && incoming().role == myProfile().role
          && docTenantId(incoming()) == userTenantId()
          && incoming().isActive == myProfile().isActive)
      );
      allow delete: if isSignedIn() && isValidId(userId) && (isPlatformAdmin() || (isAdmin() && isSameTenant(existing())));
    }

    // ---------------------------------------------------------
    // 24. Internal Conversations (Strict Tenant & Participant Isolation)
    // ---------------------------------------------------------
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId) && isSameTenant(existing()) && (isPlatformAdmin() || isAdmin() || isConversationMember(existing()));
      allow list: if isSignedIn() && isSameTenant(existing()) && (isPlatformAdmin() || isAdmin() || isConversationMember(existing()));
      allow create: if isSignedIn() && isValidId(conversationId) && isValidConversation(incoming()) && incoming().createdBy == request.auth.uid && isSameTenant(incoming()) && (
        isPlatformAdmin() ||
        isAdmin() ||
        (incoming().type == 'DIRECT' && request.auth.uid in incoming().participantIds && incoming().participantIds.size() == 2) ||
        (incoming().type == 'GROUP' && isStaff() && request.auth.uid in incoming().participantIds)
      );
      allow update: if isSignedIn() && isValidId(conversationId) && isValidConversation(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().type == existing().type
        && docTenantId(incoming()) == docTenantId(existing())
        && isSameTenant(existing())
        && (
          isPlatformAdmin() ||
          isAdmin() ||
          (isConversationMember(existing()) && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageText', 'lastMessageAt', 'lastMessageBy', 'lastMessageByName', 'readByUids', 'updatedAt']))
        );
      allow delete: if isSignedIn() && isValidId(conversationId) && isSameTenant(existing()) && (isPlatformAdmin() || isAdmin());

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(conversationId) && isValidId(messageId) && (
          isPlatformAdmin() ||
          (isAdmin() && isSameTenant(get(/databases/$(database)/documents/conversations/$(conversationId)).data)) ||
          isConversationMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
        );
        allow list: if isSignedIn() && isValidId(conversationId) && (
          isPlatformAdmin() ||
          (isAdmin() && isSameTenant(get(/databases/$(database)/documents/conversations/$(conversationId)).data)) ||
          isConversationMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
        );
        allow create: if isSignedIn() && isValidId(conversationId) && isValidId(messageId)
          && isValidInternalMessage(incoming())
          && incoming().conversationId == conversationId
          && incoming().senderId == request.auth.uid
          && exists(/databases/$(database)/documents/conversations/$(conversationId))
          && (
            isPlatformAdmin() ||
            (isAdmin() && isSameTenant(get(/databases/$(database)/documents/conversations/$(conversationId)).data)) ||
            (isConversationMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
              && get(/databases/$(database)/documents/conversations/$(conversationId)).data.type != 'BROADCAST')
          );
        allow update: if isSignedIn() && isValidId(conversationId) && isValidId(messageId)
          && isValidInternalMessage(incoming())
          && incoming().conversationId == existing().conversationId
          && incoming().senderId == existing().senderId
          && incoming().createdAt == existing().createdAt
          && (
            isPlatformAdmin() ||
            (isAdmin() && isSameTenant(get(/databases/$(database)/documents/conversations/$(conversationId)).data)) ||
            (isConversationMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
              && incoming().diff(existing()).affectedKeys().hasOnly(['readByUids']))
          );
        allow delete: if isSignedIn() && isValidId(conversationId) && isValidId(messageId) && (isPlatformAdmin() || (isAdmin() && isSameTenant(get(/databases/$(database)/documents/conversations/$(conversationId)).data)));
      }
    }

    // ---------------------------------------------------------
    // 25. Financial Adjustments & Refunds (Tenant-isolated)
    // ---------------------------------------------------------
    match /financial_adjustments/{adjustmentId} {
      allow get: if isSignedIn() && isValidId(adjustmentId) && isSameTenant(existing()) && (isFinanceStaff() || isOwnStudentRecord(existing().studentId));
      allow list: if isSignedIn() && isSameTenant(existing()) && (isFinanceStaff() || isOwnStudentRecord(existing().studentId));
      allow create: if isSignedIn() && isValidId(adjustmentId) && isValidFinancialAdjustment(incoming()) && isSameTenant(incoming()) && isTenantWritable(docTenantId(incoming())) && (isPlatformAdmin() || isAdmin()) && incoming().approvedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------
    // 26. Security & Session Timeout Policy
    // ---------------------------------------------------------
    match /security_config/{configId} {
      allow get: if isSignedIn() && isValidId(configId) && (isStaff() || isStudent());
      allow list: if isSignedIn() && (isPlatformAdmin() || isAdmin());
      allow create, update: if isSignedIn() && isValidId(configId) && isValidSecurityConfig(incoming()) && (isPlatformAdmin() || isAdmin());
      allow delete: if isSignedIn() && isValidId(configId) && (isPlatformAdmin() || isAdmin());
    }

    // ---------------------------------------------------------
    // 27. Login & Session History
    // ---------------------------------------------------------
    match /login_history/{entryId} {
      allow get: if isSignedIn() && isValidId(entryId) && (isPlatformStaff() || (isAdmin() && isSameTenant(existing())) || existing().userId == request.auth.uid);
      allow list: if isSignedIn() && (isPlatformStaff() || (isAdmin() && isSameTenant(existing())) || existing().userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(entryId) && isValidLoginHistory(incoming()) && (isStaff() || isStudent()) && incoming().userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------
    // 28. Chapa Online Payment Transactions (Tenant-isolated)
    // ---------------------------------------------------------
    match /chapa_transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && isSameTenant(existing()) && (isFinanceStaff() || isOwnStudentRecord(existing().studentId));
      allow list: if isSignedIn() && isSameTenant(existing()) && (isFinanceStaff() || isOwnStudentRecord(existing().studentId));
      allow create: if isSignedIn() && isValidId(txId) && isValidChapaTransaction(incoming())
        && isSameTenant(incoming())
        && isTenantWritable(docTenantId(incoming()))
        && incoming().approvalStatus == 'AWAITING_APPROVAL'
        && incoming().paymentStatus == 'INITIATED'
        && incoming().createdBy == request.auth.uid
        && (
          isPlatformAdmin() ||
          isAdmin() ||
          isAccountant() ||
          isManager() ||
          (isStudent() && incoming().source == 'STUDENT_PORTAL' && isOwnStudentRecord(incoming().studentId))
        );
      allow update: if isSignedIn() && isValidId(txId) && isValidChapaTransaction(incoming())
        && incoming().txRef == existing().txRef
        && incoming().studentId == existing().studentId
        && incoming().enrollmentId == existing().enrollmentId
        && incoming().amountEtb == existing().amountEtb
        && incoming().currency == existing().currency
        && incoming().paymentMethod == existing().paymentMethod
        && incoming().source == existing().source
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && docTenantId(incoming()) == docTenantId(existing())
        && isSameTenant(existing())
        && isTenantWritable(docTenantId(existing()))
        && (
          isPlatformAdmin() ||
          isAdmin() ||
          (
            (isAccountant() || isManager() || isOwnStudentRecord(existing().studentId))
            && existing().approvalStatus == 'AWAITING_APPROVAL'
            && existing().paymentStatus in ['INITIATED', 'PENDING_VERIFICATION']
            && incoming().approvalStatus == 'AWAITING_APPROVAL'
            && incoming().paymentStatus in ['PENDING_VERIFICATION', 'VERIFIED', 'FAILED', 'CANCELLED']
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'paymentStatus',
              'chapaReference',
              'chapaChannel',
              'chapaFeeEtb',
              'verificationProof',
              'verificationSummary',
              'paymentDate',
              'verifiedAt',
              'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    // ---------------------------------------------------------
    // 29. Staff Registrations & HR Records (Tenant-isolated)
    // ---------------------------------------------------------
    match /staff_records/{staffId} {
      allow get: if isSignedIn() && isValidId(staffId) && isSameTenant(existing()) && (
        isPlatformAdmin() ||
        isAdmin() ||
        isHrOfficer() ||
        ((isAccountant() || isManager()) && existing().registeredBy == request.auth.uid)
      );
      allow list: if isSignedIn() && isSameTenant(existing()) && (
        isPlatformAdmin() ||
        isAdmin() ||
        isHrOfficer() ||
        ((isAccountant() || isManager()) && existing().registeredBy == request.auth.uid)
      );
      allow create: if isSignedIn() && isValidId(staffId) && isValidStaffRecord(incoming()) && isSameTenant(incoming()) && isTenantWritable(docTenantId(incoming())) && (
        isPlatformAdmin() ||
        isAdmin() ||
        ((isAccountant() || isManager() || isHrOfficer())
          && incoming().registrationStatus == 'PENDING'
          && incoming().registeredBy == request.auth.uid
          && incoming().portalRole != 'ADMIN'
          && (!('idVerificationStatus' in incoming()) || incoming().idVerificationStatus in ['UNVERIFIED', 'PENDING_REVIEW']))
      );
      allow update: if isSignedIn() && isValidId(staffId) && isValidStaffRecord(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().staffCode == existing().staffCode
        && docTenantId(incoming()) == docTenantId(existing())
        && isSameTenant(existing())
        && isTenantWritable(docTenantId(existing()))
        && (
          isPlatformAdmin() ||
          isAdmin() ||
          ((isAccountant() || isManager() || isHrOfficer())
            && existing().registeredBy == request.auth.uid
            && existing().registrationStatus == 'PENDING'
            && incoming().registrationStatus == 'PENDING'
            && incoming().portalRole == existing().portalRole
            && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'address', 'phone', 'email', 'dateOfBirth', 'nationality', 'gender', 'photoUrl', 'updatedAt']))
        );
      allow delete: if isSignedIn() && isValidId(staffId) && isSameTenant(existing()) && (isPlatformAdmin() || (isAdmin() && isTenantWritable(docTenantId(existing()))));
    }

    // ---------------------------------------------------------
    // 30. Staff Compensation / Salary (Tenant-isolated Admin-only)
    // ---------------------------------------------------------
    match /staff_compensation/{staffId} {
      allow get: if isSignedIn() && isValidId(staffId) && isSameTenant(existing()) && (isPlatformAdmin() || isAdmin());
      allow list: if isSignedIn() && isSameTenant(existing()) && (isPlatformAdmin() || isAdmin());
      allow create: if isSignedIn() && isValidId(staffId) && isValidStaffCompensation(incoming()) && incoming().staffId == staffId && isSameTenant(incoming()) && isTenantWritable(docTenantId(incoming())) && (isPlatformAdmin() || isAdmin()) && incoming().updatedBy == request.auth.uid;
      allow update: if isSignedIn() && isValidId(staffId) && isValidStaffCompensation(incoming()) && incoming().staffId == existing().staffId && incoming().createdAt == existing().createdAt && docTenantId(incoming()) == docTenantId(existing()) && isSameTenant(existing()) && isTenantWritable(docTenantId(existing())) && (isPlatformAdmin() || isAdmin()) && incoming().updatedBy == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(staffId) && isSameTenant(existing()) && (isPlatformAdmin() || (isAdmin() && isTenantWritable(docTenantId(existing()))));
    }

    // ---------------------------------------------------------
    // 31. Restricted Encrypted Identity Documents Vault (Tenant-isolated)
    // ---------------------------------------------------------
    match /identity_documents/{docId} {
      allow get: if isSignedIn() && isValidId(docId) && isSameTenant(existing()) && (
        isPlatformAdmin() ||
        isAdmin() ||
        ((isAccountant() || isManager() || isHrOfficer()) && existing().uploadedBy == request.auth.uid && existing().verificationStatus == 'PENDING_REVIEW')
      );
      allow list: if isSignedIn() && isSameTenant(existing()) && (isPlatformAdmin() || isAdmin());
      allow create: if isSignedIn() && isValidId(docId) && isValidIdentityDocument(incoming()) && isSameTenant(incoming()) && isTenantWritable(docTenantId(incoming())) && (
        isPlatformAdmin() ||
        isAdmin() ||
        ((isAccountant() || isManager() || isHrOfficer() || isReceptionist())
          && incoming().uploadedBy == request.auth.uid
          && incoming().verificationStatus == 'PENDING_REVIEW'
          && incoming().isRedacted == false)
      );
      allow update: if isSignedIn() && isValidId(docId) && isValidIdentityDocument(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().subjectId == existing().subjectId
        && incoming().subjectType == existing().subjectType
        && incoming().uploadedBy == existing().uploadedBy
        && docTenantId(incoming()) == docTenantId(existing())
        && isSameTenant(existing())
        && isTenantWritable(docTenantId(existing()))
        && (isPlatformAdmin() || isAdmin());
      allow delete: if isSignedIn() && isValidId(docId) && isSameTenant(existing()) && (isPlatformAdmin() || (isAdmin() && isTenantWritable(docTenantId(existing()))));
    }

    // ---------------------------------------------------------
    // 32. Hashed Duplicate Identification Number Locks (Tenant-isolated)
    // ---------------------------------------------------------
    match /id_number_locks/{hashId} {
      allow get: if isSignedIn() && isValidId(hashId) && isRegistrationStaff();
      allow list: if isSignedIn() && isSameTenant(existing()) && (isPlatformAdmin() || isAdmin());
      allow create: if isSignedIn() && isValidId(hashId) && isValidIdNumberLock(incoming()) && isRegistrationStaff() && isSameTenant(incoming()) && isTenantWritable(docTenantId(incoming())) && incoming().createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(hashId) && isSameTenant(existing()) && (isPlatformAdmin() || isAdmin());
    }

    // ---------------------------------------------------------
    // 33. Atomic Sequential Registration ID Counters (Tenant-scoped)
    // ---------------------------------------------------------
    match /id_counters/{counterId} {
      allow get: if isSignedIn() && isValidId(counterId) && isRegistrationStaff();
      allow list: if isSignedIn() && isSameTenant(existing()) && (isPlatformAdmin() || isAdmin());
      allow create: if isSignedIn() && isValidId(counterId) && isValidIdCounter(incoming()) && isRegistrationStaff() && isSameTenant(incoming()) && isTenantWritable(docTenantId(incoming())) && incoming().updatedBy == request.auth.uid;
      allow update: if isSignedIn() && isValidId(counterId) && isValidIdCounter(incoming())
        && incoming().prefix == existing().prefix
        && docTenantId(incoming()) == docTenantId(existing())
        && isSameTenant(existing())
        && isTenantWritable(docTenantId(existing()))
        && incoming().updatedBy == request.auth.uid
        && (
          isPlatformAdmin() ||
          isAdmin() ||
          ((isAccountant() || isManager() || isReceptionist() || isHrOfficer()) && incoming().currentValue == existing().currentValue + 1)
        );
      allow delete: if false;
    }

    // =========================================================
    // ZACMA MULTI-TENANT SAAS PLATFORM OWNER COLLECTIONS (34-42)
    // =========================================================

    // ---------------------------------------------------------
    // 34. Tenants (Training Institutes — Platform manages; Institute Admin updates own branding only)
    // ---------------------------------------------------------
    match /tenants/{tenantId} {
      allow get: if isSignedIn() && isValidId(tenantId) && (isPlatformStaff() || tenantId == userTenantId());
      allow list: if isSignedIn() && (isPlatformStaff() || existing().tenantId == userTenantId());
      allow create: if isSignedIn() && isValidId(tenantId) && isValidTenant(incoming()) && incoming().tenantId == tenantId && isPlatformAdmin();
      allow update: if isSignedIn() && isValidId(tenantId) && isValidTenant(incoming())
        && incoming().tenantId == existing().tenantId
        && incoming().createdAt == existing().createdAt
        && (
          isPlatformAdmin() ||
          (isAdmin()
            && tenantId == userTenantId()
            && existing().status != 'SUSPENDED'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'shortName',
              'email',
              'phone',
              'country',
              'city',
              'address',
              'website',
              'logoUrl',
              'primaryColor',
              'secondaryColor',
              'studentIdPrefix',
              'staffIdPrefix',
              'receiptPrefix',
              'currency',
              'timezone',
              'academicYear',
              'paymentMethods',
              'defaultLanguage',
              'dateFormat',
              'invoiceFooterNote',
              'notificationEmailEnabled',
              'notificationSmsEnabled',
              'notificationWhatsappEnabled',
              'emailGatewayStatus',
              'smsGatewayStatus',
              'whatsappGatewayStatus',
              'smsSenderLabel',
              'updatedAt'
            ]))
        );
      allow delete: if isSignedIn() && isValidId(tenantId) && isPlatformSuperAdmin() && tenantId != 'zacma_default';
    }

    // ---------------------------------------------------------
    // 35. Subscription Plans (Platform Admin manages; Institute Admins read active plans)
    // ---------------------------------------------------------
    match /subscription_plans/{planId} {
      allow get: if isSignedIn() && isValidId(planId) && (isPlatformStaff() || isAdmin());
      allow list: if isSignedIn() && (isPlatformStaff() || (isAdmin() && existing().isActive == true));
      allow create, update: if isSignedIn() && isValidId(planId) && isValidSubscriptionPlan(incoming()) && isPlatformAdmin();
      allow delete: if isSignedIn() && isValidId(planId) && isPlatformSuperAdmin();
    }

    // ---------------------------------------------------------
    // 36. Platform Subscriptions (Platform Finance/Admin manages; Institute Admin reads own only)
    // ---------------------------------------------------------
    match /platform_subscriptions/{subId} {
      allow get: if isSignedIn() && isValidId(subId) && (isPlatformStaff() || (isAdmin() && existing().tenantId == userTenantId()));
      allow list: if isSignedIn() && (isPlatformStaff() || (isAdmin() && existing().tenantId == userTenantId()));
      allow create: if isSignedIn() && isValidId(subId) && isValidPlatformSubscription(incoming()) && isPlatformFinance();
      allow update: if isSignedIn() && isValidId(subId) && isValidPlatformSubscription(incoming()) && incoming().tenantId == existing().tenantId && incoming().createdAt == existing().createdAt && isPlatformFinance();
      allow delete: if isSignedIn() && isValidId(subId) && isPlatformSuperAdmin();
    }

    // ---------------------------------------------------------
    // 37. Platform Invoices (Strictly separate from Student Tuition Receipts)
    // ---------------------------------------------------------
    match /platform_invoices/{invoiceId} {
      allow get: if isSignedIn() && isValidId(invoiceId) && (isPlatformStaff() || (isAdmin() && existing().tenantId == userTenantId()));
      allow list: if isSignedIn() && (isPlatformStaff() || (isAdmin() && existing().tenantId == userTenantId()));
      allow create: if isSignedIn() && isValidId(invoiceId) && isValidPlatformInvoice(incoming()) && isPlatformFinance();
      allow update: if isSignedIn() && isValidId(invoiceId) && isValidPlatformInvoice(incoming()) && incoming().tenantId == existing().tenantId && incoming().invoiceNumber == existing().invoiceNumber && incoming().createdAt == existing().createdAt && isPlatformFinance();
      allow delete: if false;
    }

    // ---------------------------------------------------------
    // 38. Platform Payments (ZACMA SaaS Subscription Revenue — Strictly Platform Finance Only)
    // ---------------------------------------------------------
    match /platform_payments/{paymentId} {
      allow get: if isSignedIn() && isValidId(paymentId) && (isPlatformStaff() || (isAdmin() && existing().tenantId == userTenantId()));
      allow list: if isSignedIn() && (isPlatformStaff() || (isAdmin() && existing().tenantId == userTenantId()));
      allow create: if isSignedIn() && isValidId(paymentId) && isValidPlatformPayment(incoming()) && isPlatformFinance() && incoming().recordedBy == request.auth.uid;
      allow update: if isSignedIn() && isValidId(paymentId) && isValidPlatformPayment(incoming()) && incoming().tenantId == existing().tenantId && incoming().createdAt == existing().createdAt && isPlatformSuperAdmin();
      allow delete: if false;
    }

    // ---------------------------------------------------------
    // 39. Tenant Invitations (Secure Email-Bound Institute Admin Onboarding)
    // ---------------------------------------------------------
    match /tenant_invitations/{inviteId} {
      allow get: if isSignedIn() && isValidId(inviteId) && (
        isPlatformStaff() ||
        (isAdmin() && existing().tenantId == userTenantId()) ||
        (request.auth.token.email != null && existing().emailLower == request.auth.token.email.lower())
      );
      allow list: if isSignedIn() && (
        isPlatformStaff() ||
        (isAdmin() && existing().tenantId == userTenantId()) ||
        (request.auth.token.email != null && existing().emailLower == request.auth.token.email.lower())
      );
      allow create: if isSignedIn() && isValidId(inviteId) && isValidTenantInvitation(incoming()) && (
        isPlatformAdmin() ||
        (isAdmin() && incoming().tenantId == userTenantId() && isTenantWritable(userTenantId()))
      );
      allow update: if isSignedIn() && isValidId(inviteId) && isValidTenantInvitation(incoming())
        && incoming().tenantId == existing().tenantId
        && incoming().emailLower == existing().emailLower
        && incoming().createdAt == existing().createdAt
        && (
          isPlatformAdmin() ||
          (isAdmin() && existing().tenantId == userTenantId()) ||
          (existing().status == 'PENDING'
            && incoming().status == 'CLAIMED'
            && request.auth.token.email != null
            && existing().emailLower == request.auth.token.email.lower()
            && incoming().claimedByUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimedByUid', 'claimedAt', 'updatedAt']))
        );
      allow delete: if isSignedIn() && isValidId(inviteId) && isPlatformAdmin();
    }

    // ---------------------------------------------------------
    // 40. Support Access Sessions (Authorized, Time-Limited, Auditable — No Silent Impersonation)
    // ---------------------------------------------------------
    match /support_access_sessions/{sessionId} {
      allow get: if isSignedIn() && isValidId(sessionId) && (isPlatformStaff() || (isAdmin() && existing().tenantId == userTenantId()));
      allow list: if isSignedIn() && (isPlatformStaff() || (isAdmin() && existing().tenantId == userTenantId()));
      allow create: if isSignedIn() && isValidId(sessionId) && isValidSupportAccessSession(incoming()) && isPlatformSupport() && incoming().actorUid == request.auth.uid && incoming().status == 'ACTIVE';
      allow update: if isSignedIn() && isValidId(sessionId) && isValidSupportAccessSession(incoming())
        && incoming().tenantId == existing().tenantId
        && incoming().actorUid == existing().actorUid
        && incoming().startedAt == existing().startedAt
        && isPlatformSupport()
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'endedAt']);
      allow delete: if false;
    }

    // ---------------------------------------------------------
    // 41. Platform Global Settings (ZACMA Platform Admin manages)
    // ---------------------------------------------------------
    match /platform_settings/{settingId} {
      allow get: if isSignedIn() && isValidId(settingId) && (isPlatformStaff() || isAdmin());
      allow list: if isSignedIn() && isPlatformStaff();
      allow create, update: if isSignedIn() && isValidId(settingId) && isValidPlatformGlobalSettings(incoming()) && isPlatformAdmin();
      allow delete: if false;
    }

    // ---------------------------------------------------------
    // 42. Support Tickets (Institutes create & view own; Platform Support resolves all)
    // ---------------------------------------------------------
    match /support_tickets/{ticketId} {
      allow get: if isSignedIn() && isValidId(ticketId) && (isPlatformStaff() || (isAdmin() && existing().tenantId == userTenantId()));
      allow list: if isSignedIn() && (isPlatformStaff() || (isAdmin() && existing().tenantId == userTenantId()));
      allow create: if isSignedIn() && isValidId(ticketId) && isValidSupportTicket(incoming()) && incoming().createdBy == request.auth.uid && (isPlatformStaff() || (isAdmin() && incoming().tenantId == userTenantId()));
      allow update: if isSignedIn() && isValidId(ticketId) && isValidSupportTicket(incoming()) && incoming().tenantId == existing().tenantId && incoming().createdAt == existing().createdAt && (isPlatformSupport() || (isAdmin() && existing().tenantId == userTenantId() && incoming().diff(existing()).affectedKeys().hasOnly(['description', 'priority', 'updatedAt'])));
      allow delete: if isSignedIn() && isValidId(ticketId) && isPlatformSuperAdmin();
    }

    // ---------------------------------------------------------
    // 43. Private AI Conversations (STRICTLY Owner-Only + Tenant-Isolated — Zero Cross-User Visibility)
    // ---------------------------------------------------------
    match /ai_conversations/{convId} {
      allow get: if isSignedIn() && isValidId(convId)
        && existing().ownerUid == request.auth.uid
        && (isPlatformStaff() || existing().tenantId == userTenantId());
      allow list: if isSignedIn()
        && existing().ownerUid == request.auth.uid
        && (isPlatformStaff() || existing().tenantId == userTenantId());
      allow create: if isSignedIn() && isValidId(convId)
        && isValidAiConversation(incoming())
        && incoming().ownerUid == request.auth.uid
        && (isPlatformStaff() || incoming().tenantId == userTenantId());
      allow update: if isSignedIn() && isValidId(convId)
        && isValidAiConversation(incoming())
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid
        && incoming().tenantId == existing().tenantId
        && incoming().createdAt == existing().createdAt
        && (isPlatformStaff() || existing().tenantId == userTenantId());
      allow delete: if isSignedIn() && isValidId(convId)
        && existing().ownerUid == request.auth.uid
        && (isPlatformStaff() || existing().tenantId == userTenantId());
    }

    // ---------------------------------------------------------
    // 44. AI Usage & Cost Telemetry Logs (Immutable; Owner reads self, Admin reads tenant, Super Admin reads all)
    // ---------------------------------------------------------
    match /ai_usage_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && (
        isPlatformStaff() ||
        (isAdmin() && existing().tenantId == userTenantId()) ||
        (existing().userId == request.auth.uid && existing().tenantId == userTenantId())
      );
      allow list: if isSignedIn() && (
        isPlatformStaff() ||
        (isAdmin() && existing().tenantId == userTenantId()) ||
        (existing().userId == request.auth.uid && existing().tenantId == userTenantId())
      );
      allow create: if isSignedIn() && isValidId(logId)
        && isValidAiUsageLog(incoming())
        && incoming().userId == request.auth.uid
        && (isPlatformStaff() || incoming().tenantId == userTenantId());
      allow update, delete: if false;
    }
  }
}
