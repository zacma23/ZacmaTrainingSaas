rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Core Primitives, Platform Roles & Multi-Tenant Helpers
    // ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true && request.auth.token.email == 'zekimuluken@gmail.com';
    }

    function profileExists() {
      return exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    // Layer 1: ZACMA SaaS Platform Owner Roles
    function isPlatformSuperAdmin() {
      return isBootstrapAdmin() || (
        isSignedIn() && profileExists() && myProfile().isActive == true
        && ('platformRole' in myProfile()) && myProfile().platformRole == 'SUPER_ADMIN'
      );
    }

    function isPlatformAdmin() {
      return isPlatformSuperAdmin() || (
        isSignedIn() && profileExists() && myProfile().isActive == true
        && ('platformRole' in myProfile()) && myProfile().platformRole == 'PLATFORM_ADMIN'
      );
    }

    function isPlatformFinance() {
      return isPlatformAdmin() || (
        isSignedIn() && profileExists() && myProfile().isActive == true
        && ('platformRole' in myProfile()) && myProfile().platformRole == 'PLATFORM_FINANCE'
      );
    }

    function isPlatformSupport() {
      return isPlatformAdmin() || (
        isSignedIn() && profileExists() && myProfile().isActive == true
        && ('platformRole' in myProfile()) && myProfile().platformRole == 'PLATFORM_SUPPORT'
      );
    }

    function isPlatformStaff() {
      return isPlatformSuperAdmin() || isPlatformAdmin() || isPlatformFinance() || isPlatformSupport();
    }

    // Layer 2: Independent Training Institute Roles
    function isAdmin() {
      return isPlatformSuperAdmin() || (
        isSignedIn() && profileExists() && myProfile().isActive == true && myProfile().role == 'ADMIN'
      );
    }

    function isManager() {
      return isSignedIn() && profileExists() && myProfile().isActive == true && myProfile().role == 'MANAGER';
    }

    function isAccountant() {
      return isSignedIn() && profileExists() && myProfile().isActive == true && myProfile().role == 'ACCOUNTANT';
    }

    function isInstructor() {
      return isSignedIn() && profileExists() && myProfile().isActive == true && myProfile().role == 'INSTRUCTOR';
    }

    function isReceptionist() {
      return isSignedIn() && profileExists() && myProfile().isActive == true && myProfile().role == 'RECEPTIONIST';
    }

    function isHrOfficer() {
      return isSignedIn() && profileExists() && myProfile().isActive == true && myProfile().role == 'HR_OFFICER';
    }

    function isGeneralStaff() {
      return isSignedIn() && profileExists() && myProfile().isActive == true && myProfile().role == 'GENERAL_STAFF';
    }

    function isStudent() {
      return isSignedIn() && profileExists() && myProfile().isActive == true && myProfile().role == 'STUDENT';
    }

    function isOwnStudentRecord(studentId) {
      return isStudent() && ('linkedStudentId' in myProfile()) && myProfile().linkedStudentId == studentId;
    }

    function isStaff() {
      return isPlatformStaff() || isAdmin() || isManager() || isAccountant() || isInstructor() || isReceptionist() || isHrOfficer() || isGeneralStaff();
    }

    function isFinanceStaff() {
      return isPlatformFinance() || isAdmin() || isManager() || isAccountant();
    }

    function isRegistrationStaff() {
      return isPlatformAdmin() || isAdmin() || isManager() || isAccountant() || isReceptionist() || isHrOfficer();
    }

    // Strict Multi-Tenant Isolation Primitives (Legacy ZACMA records without tenantId map to 'zacma_default')
    function userTenantId() {
      return (profileExists() && ('tenantId' in myProfile())) ? myProfile().tenantId : 'zacma_default';
    }

    function docTenantId(data) {
      return ('tenantId' in data) ? data.tenantId : 'zacma_default';
    }

    function isSameTenant(data) {
      return isPlatformStaff() || docTenantId(data) == userTenantId();
    }

    function isTenantWritable(tid) {
      return isPlatformAdmin()
        || !exists(/databases/$(database)/documents/tenants/$(tid))
        || get(/databases/$(database)/documents/tenants/$(tid)).data.status != 'SUSPENDED';
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isOptionalNumber(data, key) {
      return !(key in data) || (data[key] is int || data[key] is float);
    }

    function isPositiveNumber(val) {
      return (val is int || val is float) && val > 0;
    }

    function isNonNegativeNumber(val) {
      return (val is int || val is float) && val >= 0;
    }

    function isBoundedStringList(val, maxLen) {
      return val is list && val.size() <= maxLen && (val.size() == 0 || val[0] is string);
    }

    function isValidRoleCode(r) {
      return r in ['ADMIN', 'MANAGER', 'ACCOUNTANT', 'INSTRUCTOR', 'RECEPTIONIST', 'HR_OFFICER', 'GENERAL_STAFF', 'STUDENT'];
    }

    function isValidPlatformRole(r) {
      return r in ['SUPER_ADMIN', 'PLATFORM_ADMIN', 'PLATFORM_SUPPORT', 'PLATFORM_FINANCE'];
    }

    function isValidCurrency(c) {
      return c in ['ETB', 'USD', 'KES', 'EUR', 'GBP'];
    }

    // ---------------------------------------------------------
    // Validation Blueprints — Institutional Collections
    // ---------------------------------------------------------
    function isValidRole(data) {
      return data.keys().hasAll(['code', 'name', 'description'])
        && data.keys().hasOnly(['code', 'name', 'description', 'permissions'])
        && isValidRoleCode(data.code)
        && isNonEmptyString(data.name, 60)
        && isNonEmptyString(data.description, 300)
        && (!('permissions' in data) || isBoundedStringList(data.permissions, 30));
    }

    function isValidProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'fullName', 'role', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'tenantId', 'platformRole', 'inviteId', 'email', 'fullName', 'phone', 'role', 'linkedStudentId', 'allowedModules', 'canExportReports', 'lastLoginAt', 'isActive', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && isOptionalString(data, 'tenantId', 80)
        && (!('platformRole' in data) || isValidPlatformRole(data.platformRole))
        && isOptionalString(data, 'inviteId', 128)
        && isNonEmptyString(data.email, 160)
        && isNonEmptyString(data.fullName, 120)
        && isOptionalString(data, 'phone', 30)
        && isOptionalString(data, 'linkedStudentId', 128)
        && (!('allowedModules' in data) || isBoundedStringList(data.allowedModules, 20))
        && (!('canExportReports' in data) || data.canExportReports is bool)
        && isOptionalString(data, 'lastLoginAt', 40)
        && isValidRoleCode(data.role)
        && data.isActive is bool
        && isNonEmptyString(data.createdAt, 40)
        && isNonEmptyString(data.updatedAt, 40);
    }

    function isValidCourse(data) {
      return data.keys().hasAll(['code', 'name', 'category', 'durationWeeks', 'feeEtb', 'schedule', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'code', 'name', 'category', 'durationWeeks', 'feeEtb', 'schedule', 'instructorId', 'instructorName', 'description', 'isActive', 'createdAt', 'updatedAt'])
        && isOptionalString(data, 'tenantId', 80)
        && isNonEmptyString(data.code, 24)
        && isNonEmptyString(data.name, 120)
        && isNonEmptyString(data.category, 80)
        && isPositiveNumber(data.durationWeeks)
        && isPositiveNumber(data.feeEtb)
        && isNonEmptyString(data.schedule, 120)
        && isOptionalString(data, 'instructorId', 128)
        && isOptionalString(data, 'instructorName', 120)
        && isOptionalString(data, 'description', 500)
        && data.isActive is bool
        && isNonEmptyString(data.createdAt, 40)
        && isNonEmptyString(data.updatedAt, 40);
    }

    function isValidPaymentPlan(data) {
      return data.keys().hasAll(['code', 'name', 'installmentCount', 'intervalDays', 'isActive'])
        && data.keys().hasOnly(['tenantId', 'code', 'name', 'installmentCount', 'intervalDays', 'description', 'isActive'])
        && isOptionalString(data, 'tenantId', 80)
        && data.code in ['FULL', 'MONTHLY', 'TWO_MONTH', 'THREE_MONTH', 'SIX_MONTH', 'CUSTOM']
        && isNonEmptyString(data.name, 80)
        && isPositiveNumber(data.installmentCount)
        && isNonNegativeNumber(data.intervalDays)
        && isOptionalString(data, 'description', 240)
        && data.isActive is bool;
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['studentCode', 'fullName', 'gender', 'phone', 'address', 'courseId', 'courseName', 'enrollmentDate', 'courseFeeEtb', 'paymentPlanCode', 'registrationStatus', 'registeredBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'studentCode', 'fullName', 'gender', 'phone', 'altPhone', 'email', 'dateOfBirth', 'nationality', 'address', 'photoUrl', 'idDocumentType', 'idNumberMasked', 'idNumberHash', 'idExpiryDate', 'idVaultRefId', 'idVerificationStatus', 'ocrConfidenceSummary', 'initialPaymentEtb', 'courseId', 'courseName', 'enrollmentDate', 'registrationDateEthiopian', 'registrationTimeEat', 'courseFeeEtb', 'paymentPlanCode', 'registrationStatus', 'registeredBy', 'registeredByName', 'approvedBy', 'approvedByName', 'approvedAt', 'rejectionReason', 'createdAt', 'updatedAt'])
        && isOptionalString(data, 'tenantId', 80)
        && isNonEmptyString(data.studentCode, 28)
        && data.studentCode.matches('^[A-Z0-9]{2,10}-(?:[0-9]{4}|STU)-[0-9]{4,}$')
        && isNonEmptyString(data.fullName, 120)
        && data.gender in ['Male', 'Female', 'Unspecified']
        && isNonEmptyString(data.phone, 30)
        && isOptionalString(data, 'altPhone', 30)
        && isOptionalString(data, 'email', 160)
        && isOptionalString(data, 'dateOfBirth', 20)
        && isOptionalString(data, 'nationality', 80)
        && isNonEmptyString(data.address, 240)
        && isOptionalString(data, 'photoUrl', 90000)
        && (!('idDocumentType' in data) || data.idDocumentType in ['NATIONAL_ID', 'ETHIOPIAN_FAYDA_ID', 'PASSPORT', 'DRIVING_LICENCE'])
        && isOptionalString(data, 'idNumberMasked', 40)
        && isOptionalString(data, 'idNumberHash', 80)
        && isOptionalString(data, 'idExpiryDate', 20)
        && isOptionalString(data, 'idVaultRefId', 128)
        && (!('idVerificationStatus' in data) || data.idVerificationStatus in ['UNVERIFIED', 'PENDING_REVIEW', 'VERIFIED', 'FLAGGED', 'REJECTED'])
        && isOptionalString(data, 'ocrConfidenceSummary', 240)
        && (!('initialPaymentEtb' in data) || isNonNegativeNumber(data.initialPaymentEtb))
        && isNonEmptyString(data.courseId, 128)
        && isNonEmptyString(data.courseName, 120)
        && isNonEmptyString(data.enrollmentDate, 20)
        && isOptionalString(data, 'registrationDateEthiopian', 40)
        && isOptionalString(data, 'registrationTimeEat', 30)
        && isPositiveNumber(data.courseFeeEtb)
        && data.paymentPlanCode in ['FULL', 'MONTHLY', 'TWO_MONTH', 'THREE_MONTH', 'SIX_MONTH', 'CUSTOM']
        && data.registrationStatus in ['PENDING', 'APPROVED', 'REJECTED']
        && isNonEmptyString(data.registeredBy, 128)
        && isOptionalString(data, 'registeredByName', 120)
        && isOptionalString(data, 'approvedBy', 128)
        && isOptionalString(data, 'approvedByName', 120)
        && isOptionalString(data, 'approvedAt', 40)
        && isOptionalString(data, 'rejectionReason', 300)
        && isNonEmptyString(data.createdAt, 40)
        && isNonEmptyString(data.updatedAt, 40);
    }

    function isValidEnrollment(data) {
      return data.keys().hasAll(['studentId', 'studentCode', 'studentName', 'courseId', 'courseName', 'paymentPlanCode', 'enrollmentDate', 'agreedFeeEtb', 'approvedPaidEtb', 'remainingBalanceEtb', 'status', 'registeredBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'studentId', 'studentCode', 'studentName', 'courseId', 'courseName', 'instructorId', 'paymentPlanCode', 'paymentPlanName', 'enrollmentDate', 'agreedFeeEtb', 'approvedPaidEtb', 'remainingBalanceEtb', 'status', 'registeredBy', 'approvedBy', 'createdAt', 'updatedAt'])
        && isOptionalString(data, 'tenantId', 80)
        && isNonEmptyString(data.studentId, 128)
        && isNonEmptyString(data.studentCode, 28)
        && isNonEmptyString(data.studentName, 120)
        && isNonEmptyString(data.courseId, 128)
        && isNonEmptyString(data.courseName, 120)
        && isOptionalString(data, 'instructorId', 128)
        && data.paymentPlanCode in ['FULL', 'MONTHLY', 'TWO_MONTH', 'THREE_MONTH', 'SIX_MONTH', 'CUSTOM']
        && isOptionalString(data, 'paymentPlanName', 80)
        && isNonEmptyString(data.enrollmentDate, 20)
        && isPositiveNumber(data.agreedFeeEtb)
        && isNonNegativeNumber(data.approvedPaidEtb)
        && isNonNegativeNumber(data.remainingBalanceEtb)
        && data.status in ['PENDING', 'ACTIVE', 'COMPLETED', 'REJECTED']
        && isNonEmptyString(data.registeredBy, 128)
        && isOptionalString(data, 'approvedBy', 128)
        && isNonEmptyString(data.createdAt, 40)
        && isNonEmptyString(data.updatedAt, 40);
    }

    function isValidInstallment(data) {
      return data.keys().hasAll(['enrollmentId', 'studentId', 'studentCode', 'studentName', 'courseId', 'courseName', 'installmentNumber', 'dueDate', 'amountDueEtb', 'amountPaidEtb', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'enrollmentId', 'studentId', 'studentCode', 'studentName', 'courseId', 'courseName', 'installmentNumber', 'dueDate', 'amountDueEtb', 'amountPaidEtb', 'status', 'createdAt', 'updatedAt'])
        && isOptionalString(data, 'tenantId', 80)
        && isNonEmptyString(data.enrollmentId, 128)
        && isNonEmptyString(data.studentId, 128)
        && isNonEmptyString(data.studentCode, 28)
        && isNonEmptyString(data.studentName, 120)
        && isNonEmptyString(data.courseId, 128)
        && isNonEmptyString(data.courseName, 120)
        && isPositiveNumber(data.installmentNumber)
        && isNonEmptyString(data.dueDate, 20)
        && isPositiveNumber(data.amountDueEtb)
        && isNonNegativeNumber(data.amountPaidEtb)
        && data.status in ['UNPAID', 'PARTIAL', 'PAID', 'OVERDUE']
        && isNonEmptyString(data.createdAt, 40)
        && isNonEmptyString(data.updatedAt, 40);
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['transactionRef', 'enrollmentId', 'studentId', 'studentCode', 'studentName', 'courseId', 'courseName', 'amountEtb', 'paymentDate', 'paymentMethod', 'recordedBy', 'recordedByName', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'transactionRef', 'enrollmentId', 'studentId', 'studentCode', 'studentName', 'courseId', 'courseName', 'amountEtb', 'paymentDate', 'paymentMethod', 'recordedBy', 'recordedByName', 'status', 'approvedBy', 'approvedByName', 'approvalDate', 'rejectionReason', 'receiptId', 'receiptNumber', 'notes', 'createdAt', 'updatedAt'])
        && isOptionalString(data, 'tenantId', 80)
        && isNonEmptyString(data.transactionRef, 64)
        && data.transactionRef.matches('^[A-Za-z0-9\\-_]+$')
        && isNonEmptyString(data.enrollmentId, 128)
        && isNonEmptyString(data.studentId, 128)
        && isNonEmptyString(data.studentCode, 28)
        && isNonEmptyString(data.studentName, 120)
        && isNonEmptyString(data.courseId, 128)
        && isNonEmptyString(data.courseName, 120)
        && isPositiveNumber(data.amountEtb)
        && isNonEmptyString(data.paymentDate, 20)
        && data.paymentMethod in ['Cash', 'CBE Birr', 'Telebirr', 'Bank Transfer', 'Check', 'Chapa']
        && isNonEmptyString(data.recordedBy, 128)
        && isNonEmptyString(data.recordedByName, 120)
        && data.status in ['PENDING', 'APPROVED', 'REJECTED']
        && isOptionalString(data, 'approvedBy', 128)
        && isOptionalString(data, 'approvedByName', 120)
        && isOptionalString(data, 'approvalDate', 40)
        && isOptionalString(data, 'rejectionReason', 300)
        && isOptionalString(data, 'receiptId', 128)
        && isOptionalString(data, 'receiptNumber', 40)
        && isOptionalString(data, 'notes', 400)
        && isNonEmptyString(data.createdAt, 40)
        && isNonEmptyString(data.updatedAt, 40);
    }

    function isValidPaymentRef(data) {
      return data.keys().hasAll(['paymentId', 'transactionRef', 'recordedBy', 'createdAt'])
        && data.keys().hasOnly(['tenantId', 'paymentId', 'transactionRef', 'recordedBy', 'createdAt'])
        && isOptionalString(data, 'tenantId', 80)
        && isNonEmptyString(data.paymentId, 128)
        && isNonEmptyString(data.transactionRef, 64)
        && isNonEmptyString(data.recordedBy, 128)
        && isNonEmptyString(data.createdAt, 40);
    }

    function isValidReceipt(data) {
      return data.keys().hasAll(['receiptNumber', 'paymentId', 'transactionRef', 'studentId', 'studentCode', 'studentName', 'courseName', 'previousBalanceEtb', 'amountPaidEtb', 'remainingBalanceEtb', 'paymentDate', 'paymentMethod', 'authorizedBy', 'verificationHash', 'issuedAt'])
        && data.keys().hasOnly(['tenantId', 'receiptNumber', 'paymentId', 'transactionRef', 'studentId', 'studentCode', 'studentName', 'studentPhone', 'courseName', 'previousBalanceEtb', 'amountPaidEtb', 'remainingBalanceEtb', 'paymentDate', 'paymentMethod', 'authorizedBy', 'verificationHash', 'issuedAt'])
        && isOptionalString(data, 'tenantId', 80)
        && isNonEmptyString(data.receiptNumber, 40)
        && isNonEmptyString(data.paymentId, 128)
        && isNonEmptyString(data.transactionRef, 64)
        && isNonEmptyString(data.studentId, 128)
        && isNonEmptyString(data.studentCode, 28)
        && isNonEmptyString(data.studentName, 120)
        && isOptionalString(data, 'studentPhone', 30)
        && isNonEmptyString(data.courseName, 120)
        && isNonNegativeNumber(data.previousBalanceEtb)
        && isPositiveNumber(data.amountPaidEtb)
        && isNonNegativeNumber(data.remainingBalanceEtb)
        && isNonEmptyString(data.paymentDate, 20)
        && isNonEmptyString(data.paymentMethod, 40)
        && isNonEmptyString(data.authorizedBy, 120)
        && isNonEmptyString(data.verificationHash, 80)
        && isNonEmptyString(data.issuedAt, 40);
    }

    function isValidExpenseCategory(data) {
      return data.keys().hasAll(['name', 'isActive'])
        && data.keys().hasOnly(['tenantId', 'name', 'description', 'isActive'])
        && isOptionalString(data, 'tenantId', 80)
        && isNonEmptyString(data.name, 80)
        && isOptionalString(data, 'description', 240)
        && data.isActive is bool;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['categoryId', 'categoryName', 'title', 'amountEtb', 'expenseDate', 'paymentMethod', 'recordedBy', 'recordedByName', 'createdAt'])
        && data.keys().hasOnly(['tenantId', 'categoryId', 'categoryName', 'title', 'amountEtb', 'expenseDate', 'paymentMethod', 'referenceNo', 'recordedBy', 'recordedByName', 'notes', 'createdAt'])
        && isOptionalString(data, 'tenantId', 80)
        && isNonEmptyString(data.categoryId, 128)
        && isNonEmptyString(data.categoryName, 80)
        && isNonEmptyString(data.title, 140)
        && isPositiveNumber(data.amountEtb)
        && isNonEmptyString(data.expenseDate, 20)
        && data.paymentMethod in ['Cash', 'CBE Birr', 'Telebirr', 'Bank Transfer', 'Check', 'Chapa']
        && isOptionalString(data, 'referenceNo', 64)
        && isNonEmptyString(data.recordedBy, 128)
        && isNonEmptyString(data.recordedByName, 120)
        && isOptionalString(data, 'notes', 400)
        && isNonEmptyString(data.createdAt, 40);
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['enrollmentId', 'studentId', 'studentCode', 'studentName', 'courseId', 'courseName', 'attendanceDate', 'status', 'recordedBy', 'recordedByName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'enrollmentId', 'studentId', 'studentCode', 'studentName', 'courseId', 'courseName', 'attendanceDate', 'status', 'recordedBy', 'recordedByName', 'remarks', 'createdAt', 'updatedAt'])
        && isOptionalString(data, 'tenantId', 80)
        && isNonEmptyString(data.enrollmentId, 128)
        && isNonEmptyString(data.studentId, 128)
        && isNonEmptyString(data.studentCode, 28)
        && isNonEmptyString(data.studentName, 120)
        && isNonEmptyString(data.courseId, 128)
        && isNonEmptyString(data.courseName, 120)
        && isNonEmptyString(data.attendanceDate, 20)
        && data.status in ['PRESENT', 'ABSENT', 'LATE', 'EXCUSED']
        && isNonEmptyString(data.recordedBy, 128)
        && isNonEmptyString(data.recordedByName, 120)
        && isOptionalString(data, 'remarks', 240)
        && isNonEmptyString(data.createdAt, 40)
        && isNonEmptyString(data.updatedAt, 40);
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['type', 'title', 'message', 'targetRole', 'isRead', 'createdAt'])
        && data.keys().hasOnly(['tenantId', 'type', 'title', 'message', 'targetRole', 'recipientUid', 'category', 'actionSection', 'studentId', 'studentCode', 'studentName', 'courseName', 'expectedAmountEtb', 'paidAmountEtb', 'remainingBalanceEtb', 'dueDate', 'paymentStatus', 'dedupKey', 'entityType', 'entityId', 'isRead', 'createdAt'])
        && isOptionalString(data, 'tenantId', 80)
        && data.type in ['DEADLINE_APPROACHING', 'OVERDUE_BALANCE', 'PENDING_REGISTRATION', 'PENDING_STAFF_REGISTRATION', 'STAFF_REGISTRATION_APPROVED', 'ID_VERIFICATION_FLAGGED', 'PENDING_PAYMENT', 'REJECTED_PAYMENT', 'UPCOMING_PAYMENT', 'PAYMENT_DUE_TODAY', 'PAYMENT_OVERDUE', 'PAYMENT_RECEIVED', 'PAYMENT_APPROVED', 'PAYMENT_REJECTED', 'OUTSTANDING_BALANCE', 'REGISTRATION_APPROVED', 'COURSE_ANNOUNCEMENT', 'ATTENDANCE_UPDATE', 'INSTRUCTOR_MESSAGE', 'ADMIN_ANNOUNCEMENT', 'SCHEDULE_CHANGE', 'NEW_INTERNAL_MESSAGE', 'CHAPA_PAYMENT_LINK', 'CHAPA_PAYMENT_VERIFIED', 'CHAPA_PAYMENT_APPROVED', 'CHAPA_PAYMENT_REJECTED', 'SUBSCRIPTION_EXPIRING', 'INSTITUTE_PROVISIONED', 'SUPPORT_SESSION_STARTED']
        && isNonEmptyString(data.title, 140)
        && isNonEmptyString(data.message, 420)
        && (data.targetRole == 'ALL' || isValidRoleCode(data.targetRole))
        && isOptionalString(data, 'recipientUid', 128)
        && isOptionalString(data, 'category', 40)
        && isOptionalString(data, 'actionSection', 40)
        && isOptionalString(data, 'studentId', 128)
        && isOptionalString(data, 'studentCode', 28)
        && isOptionalString(data, 'studentName', 120)
        && isOptionalString(data, 'courseName', 120)
        && isOptionalNumber(data, 'expectedAmountEtb')
        && isOptionalNumber(data, 'paidAmountEtb')
        && isOptionalNumber(data, 'remainingBalanceEtb')
        && isOptionalString(data, 'dueDate', 20)
        && isOptionalString(data, 'paymentStatus', 30)
        && isOptionalString(data, 'dedupKey', 128)
        && isOptionalString(data, 'entityType', 40)
        && isOptionalString(data, 'entityId', 128)
        && data.isRead is bool
        && isNonEmptyString(data.createdAt, 40);
    }

    function isValidNotificationPreference(data) {
      return data.keys().hasAll(['userId', 'inAppEnabled', 'emailEnabled', 'smsEnabled', 'whatsappEnabled', 'upcomingLeadDays', 'overdueRepeatDays', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'inAppEnabled', 'emailEnabled', 'smsEnabled', 'whatsappEnabled', 'upcomingLeadDays', 'overdueRepeatDays', 'updatedAt'])
        && isNonEmptyString(data.userId, 128)
        && data.inAppEnabled is bool
        && data.emailEnabled is bool
        && data.smsEnabled is bool
        && data.whatsappEnabled is bool
        && isPositiveNumber(data.upcomingLeadDays)
        && isPositiveNumber(data.overdueRepeatDays)
        && isNonEmptyString(data.updatedAt, 40);
    }

    function isValidChapaTransaction(data) {
      return data.keys().hasAll(['txRef', 'studentId', 'studentCode', 'studentName', 'courseId', 'courseName', 'enrollmentId', 'amountEtb', 'currency', 'paymentMethod', 'source', 'paymentStatus', 'approvalStatus', 'createdBy', 'createdByName', 'createdByRole', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['tenantId', 'txRef', 'studentId', 'studentCode', 'studentName', 'studentPhone', 'studentEmail', 'courseId', 'courseName', 'enrollmentId', 'amountEtb', 'currency', 'paymentMethod', 'source', 'checkoutUrl', 'paymentStatus', 'approvalStatus', 'chapaReference', 'chapaChannel', 'chapaFeeEtb', 'verificationProof', 'verificationSummary', 'paymentDate', 'verifiedAt', 'expiresAt', 'createdBy', 'createdByName', 'createdByRole', 'approvedBy', 'approvedByName', 'approvedAt', 'approvalNotes', 'rejectionReason', 'paymentId', 'receiptId', 'receiptNumber', 'createdAt', 'updatedAt'])
        && isOptionalString(data, 'tenantId', 80)
        && isNonEmptyString(data.txRef, 64)
        && data.txRef.matches('^[A-Za-z0-9\\-_]+$')
        && isNonEmptyString(data.studentId, 128)
        && isNonEmptyString(data.studentCode, 28)
        && isNonEmptyString(data.studentName, 120)
        && isOptionalString(data, 'studentPhone', 30)
        && isOptionalString(data, 'studentEmail', 160)
        && isNonEmptyString(data.courseId, 128)
        && isNonEmptyString(data.courseName, 120)
        && isNonEmptyString(data.enrollmentId, 128)
        && isPositiveNumber(data.amountEtb)
        && isValidCurrency(data.currency)
        && data.paymentMethod == 'Chapa'
        && data.source in ['STUDENT_PORTAL', 'PAYMENT_LINK']
        && isOptionalString(data, 'checkoutUrl', 1000)
        && data.paymentStatus in ['INITIATED', 'PENDING_VERIFICATION', 'VERIFIED', 'FAILED', 'CANCELLED', 'REFUNDED']
        && data.approvalStatus in ['AWAITING_APPROVAL', 'APPROVED', 'REJECTED']
        && isOptionalString(data, 'chapaReference', 120)
        && isOptionalString(data, 'chapaChannel', 80)
        && isOptionalNumber(data, 'chapaFeeEtb')
        && isOptionalString(data, 'verificationProof', 128)
        && isOptionalString(data, 'verificationSummary', 400)
        && isOptionalString(data, 'paymentDate', 20)
        && isOptionalString(data, 'verifiedAt', 40)
        && isOptionalString(data, 'expiresAt', 40)
        && isNonEmptyString(data.createdBy, 128)
        && isNonEmptyString(data.createdByName, 120)
        && isValidRoleCode(data.createdByRole)
        && isOptionalString(data, 'approvedBy', 128)
        && isOptionalString(data, 'approvedByName', 120)
        && isOptionalString(data, 'approvedAt', 40)
        && isOptionalString(data, 'approvalNotes', 400)
        && isOptionalString(data, 'rejectionReason', 300)
        && isOptionalString(data, 'paymentId', 128)
        && isOptionalString(data, 'receiptId', 128)
        && isOptionalString(data, 'receiptNumber', 40)
        && isNonEmptyString(data.createdAt, 40)
        && isNonEmptyString(data.updatedAt, 40);
    }

    function isValidSchemaMigration(data) {
      return data.keys().hasAll(['version', 'name', 'appliedBy', 'appliedByName', 'status', 'appliedAt'])
        && data.keys().hasOnly(['version', 'name', 'appliedBy', 'appliedByName', 'status', 'notes', 'appliedAt'])
